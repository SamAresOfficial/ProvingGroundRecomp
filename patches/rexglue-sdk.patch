+uint32_t GetTargetFrameRate() { return g_target_fps.load(std::memory_order_relaxed); }
+
+void SetDisplayRefreshRate(double hz) {
+  // Ignore nonsense from drivers (0 or 1 means "the hardware default" on Windows).
+  g_refresh_hz.store(hz >= 20.0 && hz <= 1000.0 ? hz : 0.0, std::memory_order_relaxed);
+}
+double GetDisplayRefreshRate() { return g_refresh_hz.load(std::memory_order_relaxed); }
+
+void ReportPacing(Pacing pacing, double frame_period_seconds) {
+  g_pacing_period.store(frame_period_seconds, std::memory_order_relaxed);
+  g_pacing.store(pacing, std::memory_order_relaxed);
+  g_pacing_reported_at.store(Now(), std::memory_order_release);
+}
+
+Pacing GetPacing(double* frame_period_seconds_out) {
+  const double reported_at = g_pacing_reported_at.load(std::memory_order_acquire);
+  Pacing pacing = g_pacing.load(std::memory_order_relaxed);
+  if (Now() - reported_at > kPacingReportLifetime) pacing = Pacing::kNone;
+  if (frame_period_seconds_out) {
+    *frame_period_seconds_out = g_pacing_period.load(std::memory_order_relaxed);
+  }
+  return pacing;
+}
+
+double Now() {
+  return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+void SleepUntil(double deadline_seconds) {
+  // High-resolution timers wake within about 50-100 us; the spin covers that, and is kept short
+  // as it holds a core busy.
+  constexpr double kSpin = 200e-6;
+  const double sleep = deadline_seconds - kSpin - Now();
+  if (sleep > 0.0) {
+#if REX_PLATFORM_WIN32
+    struct Timer {
+      HANDLE handle = CreateWaitableTimerExW(
+          nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+      ~Timer() {
+        if (handle) CloseHandle(handle);
+      }
+    };
+    static thread_local Timer timer;
+    LARGE_INTEGER due;
+    due.QuadPart = -LONGLONG(sleep * 1e7);
+    if (timer.handle && SetWaitableTimerEx(timer.handle, &due, 0, nullptr, nullptr, nullptr, 0)) {
+      WaitForSingleObject(timer.handle, INFINITE);
+    } else if (sleep >= 0.002) {
+      // Without high-resolution timers, Sleep can wake up a timer period late.
+      ::Sleep(DWORD(sleep * 1000.0) - 1);
+    }
+#else
+    std::this_thread::sleep_for(std::chrono::duration<double>(sleep));
+#endif
+  }
+  while (Now() < deadline_seconds) {
+    REX_PRESENT_SYNC_CPU_RELAX();
+  }
+}
