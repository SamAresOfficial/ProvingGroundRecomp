+    if (wait_result == VK_TIMEOUT) {
+      shown = 0.0;
+    } else if (wait_end - wait_start > 0.0003) {
+      // The wait ended when the frame was shown: a vblank, just now.
+      shown = wait_end;
+      vblank_clock.Anchor(wait_end);
+    } else {
+      // Already shown: on the first vblank after it was queued, as far as the clock knows.
+      shown = vblank_clock.NextVblankAt(paint_context.swapchain_last_present_time);
+    }
+    if (sync.interval > 1 && shown > 0.0) {
