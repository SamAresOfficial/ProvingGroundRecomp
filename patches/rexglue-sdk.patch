+bool VulkanCommandProcessor::InitializeTemporalUpscale() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const ui::vulkan::VulkanInstance::Functions& ifn = vulkan_device->vulkan_instance()->functions();
+  const VkDevice device = vulkan_device->device();
+
+  // The inputs are written by compute shaders and sampled by the upscaler.
+  const VkFormat formats[] = {ui::vulkan::VulkanPresenter::kGuestOutputFormat, VK_FORMAT_R32_SFLOAT,
+                              VK_FORMAT_R16G16_SFLOAT, VK_FORMAT_R8_UNORM};
+  for (VkFormat format : formats) {
+    VkFormatProperties format_properties;
+    ifn.vkGetPhysicalDeviceFormatProperties(vulkan_device->physical_device(), format,
+                                            &format_properties);
+    constexpr VkFormatFeatureFlags kNeededFeatures =
+        VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT |
+        VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT;
+    if ((format_properties.optimalTilingFeatures & kNeededFeatures) != kNeededFeatures) {
+      REXGPU_WARN("Temporal upscaling is unavailable: a format of its inputs can't be both "
+                  "written by compute shaders and sampled");
+      return false;
+    }
+  }
+
+  // One layout for the three passes: up to two sampled images and two written images.
+  std::array<VkDescriptorSetLayoutBinding, 4> bindings{};
+  for (uint32_t i = 0; i < uint32_t(bindings.size()); ++i) {
+    bindings[i].binding = i;
+    bindings[i].descriptorType =
+        i >= 2 ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    bindings[i].descriptorCount = 1;
+    bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+  }
+  VkDescriptorSetLayoutCreateInfo set_layout_create_info = {};
+  set_layout_create_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+  set_layout_create_info.bindingCount = uint32_t(bindings.size());
+  set_layout_create_info.pBindings = bindings.data();
+  if (dfn.vkCreateDescriptorSetLayout(device, &set_layout_create_info, nullptr,
+                                      &temporal_upscale_descriptor_set_layout_) != VK_SUCCESS) {
+    return false;
+  }
+  const uint32_t set_count = kTemporalUpscaleDescriptorSetCount * kMaxFramesInFlight;
+  std::array<VkDescriptorPoolSize, 2> pool_sizes;
+  pool_sizes[0].type = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+  pool_sizes[0].descriptorCount = 2 * set_count;
+  pool_sizes[1].type = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  pool_sizes[1].descriptorCount = 2 * set_count;
+  VkDescriptorPoolCreateInfo pool_create_info = {};
+  pool_create_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+  pool_create_info.maxSets = set_count;
+  pool_create_info.poolSizeCount = uint32_t(pool_sizes.size());
+  pool_create_info.pPoolSizes = pool_sizes.data();
+  if (dfn.vkCreateDescriptorPool(device, &pool_create_info, nullptr,
+                                 &temporal_upscale_descriptor_pool_) != VK_SUCCESS) {
+    return false;
+  }
+  VkDescriptorSetAllocateInfo set_allocate_info = {};
+  set_allocate_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+  set_allocate_info.descriptorPool = temporal_upscale_descriptor_pool_;
+  set_allocate_info.descriptorSetCount = 1;
+  set_allocate_info.pSetLayouts = &temporal_upscale_descriptor_set_layout_;
+  for (auto& frame_descriptors : temporal_upscale_descriptors_) {
+    for (VkDescriptorSet& descriptor_set : frame_descriptors) {
+      if (dfn.vkAllocateDescriptorSets(device, &set_allocate_info, &descriptor_set) !=
+          VK_SUCCESS) {
+        return false;
+      }
+    }
+  }
+  VkPushConstantRange push_constant_range = {};
+  push_constant_range.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+  push_constant_range.size = sizeof(TemporalUpscaleInputsConstants);
+  static_assert(sizeof(TemporalUpscaleMaskConstants) <= sizeof(TemporalUpscaleInputsConstants));
+  static_assert(sizeof(TemporalUpscaleCompositeConstants) <=
+                sizeof(TemporalUpscaleInputsConstants));
+  VkPipelineLayoutCreateInfo pipeline_layout_create_info = {};
+  pipeline_layout_create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+  pipeline_layout_create_info.setLayoutCount = 1;
+  pipeline_layout_create_info.pSetLayouts = &temporal_upscale_descriptor_set_layout_;
+  pipeline_layout_create_info.pushConstantRangeCount = 1;
+  pipeline_layout_create_info.pPushConstantRanges = &push_constant_range;
+  if (dfn.vkCreatePipelineLayout(device, &pipeline_layout_create_info, nullptr,
+                                 &temporal_upscale_pipeline_layout_) != VK_SUCCESS) {
+    return false;
+  }
+
+  auto create_pipeline = [&](const char* source, const char* name) -> VkPipeline {
+    std::vector<uint32_t> spirv;
+    std::string compile_error;
+    VkPipeline pipeline = VK_NULL_HANDLE;
+    if (CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, source, spirv, compile_error)) {
+      pipeline = ui::vulkan::util::CreateComputePipeline(
+          vulkan_device, temporal_upscale_pipeline_layout_, spirv.data(),
+          sizeof(uint32_t) * spirv.size());
+    }
+    if (pipeline == VK_NULL_HANDLE) {
+      REXGPU_WARN("Failed to create the temporal upscaling {} pipeline {}", name, compile_error);
+    }
+    return pipeline;
+  };
+  temporal_upscale_inputs_pipeline_ =
+      create_pipeline(kTemporalUpscaleInputsComputeSource, "depth and motion vector");
+  // The HUD mask needs both of these; without them the HUD goes through the upscaler.
+  temporal_upscale_mask_pipeline_ = create_pipeline(kTemporalUpscaleMaskComputeSource, "HUD mask");
+  temporal_upscale_composite_pipeline_ =
+      create_pipeline(kTemporalUpscaleCompositeComputeSource, "HUD composition");
+  return temporal_upscale_inputs_pipeline_ != VK_NULL_HANDLE;
+}
