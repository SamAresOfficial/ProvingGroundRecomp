+void Presenter::UpdateDisplayRefreshRateFromUIThread() {
+  double refresh_hz = 0.0;
+#if REX_PLATFORM_WIN32
+  // The current mode of the monitor the window is on. DEVMODE has whole hertz only (59 for a
+  // 59.94 Hz mode, which beats against a 60 Hz guess every 17 seconds), so the exact rational
+  // rate comes from the closest DXGI mode where the output is found.
+  if (surface_win32_monitor_) {
+    MONITORINFOEXW monitor_info = {};
+    monitor_info.cbSize = sizeof(monitor_info);
+    DEVMODEW mode = {};
+    mode.dmSize = sizeof(mode);
+    if (GetMonitorInfoW(surface_win32_monitor_, &monitor_info) &&
+        EnumDisplaySettingsW(monitor_info.szDevice, ENUM_CURRENT_SETTINGS, &mode) &&
+        mode.dmDisplayFrequency > 1) {
+      UINT numerator = mode.dmDisplayFrequency;
+      UINT denominator = 1;
+      if (numerator % 30 == 29) {
+        // The NTSC-derived rates (59.94, 119.88...) that Windows rounds down.
+        numerator = (numerator + 1) * 1000;
+        denominator = 1001;
+      }
+      if (dxgi_ui_tick_factory_) {
+        Microsoft::WRL::ComPtr<IDXGIOutput> output =
+            GetDXGIOutputForMonitor(dxgi_ui_tick_factory_.Get(), surface_win32_monitor_);
+        DXGI_MODE_DESC mode_to_match = {};
+        mode_to_match.Width = mode.dmPelsWidth;
+        mode_to_match.Height = mode.dmPelsHeight;
+        mode_to_match.RefreshRate.Numerator = numerator;
+        mode_to_match.RefreshRate.Denominator = denominator;
+        mode_to_match.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        DXGI_MODE_DESC closest_mode;
+        if (output &&
+            SUCCEEDED(output->FindClosestMatchingMode(&mode_to_match, &closest_mode, nullptr)) &&
+            closest_mode.RefreshRate.Numerator && closest_mode.RefreshRate.Denominator &&
+            closest_mode.Width == mode.dmPelsWidth && closest_mode.Height == mode.dmPelsHeight) {
+          const double closest_hz =
+              double(closest_mode.RefreshRate.Numerator) / closest_mode.RefreshRate.Denominator;
+          // Only a refinement of the same rate, not a different mode.
+          if (std::abs(closest_hz - double(mode.dmDisplayFrequency)) < 1.0) {
+            numerator = closest_mode.RefreshRate.Numerator;
+            denominator = closest_mode.RefreshRate.Denominator;
+          }
+        }
+      }
+      refresh_hz = double(numerator) / double(denominator);
+    }
+  }
+#else
+  if (surface_ && window_) {
+    refresh_hz = window_->GetDisplayRefreshRate();
+  }
+#endif  // XE_PLATFORM
+  if (refresh_hz != present_sync::GetDisplayRefreshRate()) {
+    present_sync::SetDisplayRefreshRate(refresh_hz);
+    if (refresh_hz > 0.0) {
+      REXLOG_INFO("Presenter: display refresh rate {:.3f} Hz", refresh_hz);
+    }
+  }
 }
 
