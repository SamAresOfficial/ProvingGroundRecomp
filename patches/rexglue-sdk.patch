+bool PrimitiveProcessor::ProcessStaticResetIndices16(uint32_t base, uint32_t count,
+                                                     uint32_t bytes,
+                                                     uint32_t reset_index_guest_endian,
+                                                     CachedResult& result) {
+  if (!REXCVAR_GET(gpu_trust_native_ranges) || !native_ranges::Count()) {
+    return false;
+  }
+  const uint64_t key = (uint64_t(base) << 32) | count;
+  const uint32_t removal_version = native_ranges::RemovalVersion();
+  auto it = static_index_entries_.find(key);
+  uint32_t generation;
+  if (it != static_index_entries_.end() && it->second.removal_version == removal_version) {
+    // Nothing was replaced since the range was found.
+    generation = it->second.generation;
+  } else {
+    generation = native_ranges::Lookup(base, bytes);
+    if (!generation) {
+      return false;
+    }
+    if (it != static_index_entries_.end() && it->second.generation == generation) {
+      it->second.removal_version = removal_version;
+    }
+  }
+  if (it == static_index_entries_.end() || it->second.generation != generation ||
+      it->second.reset_index_guest_endian != reset_index_guest_endian ||
+      (it->second.failed && it->second.failed_frees != persistent_index_buffer_frees_)) {
+    StaticIndexEntry entry;
+    entry.generation = generation;
+    entry.removal_version = removal_version;
+    entry.reset_index_guest_endian = reset_index_guest_endian;
+    entry.result = result;
+    entry.persistent_handle = SIZE_MAX;
+    entry.bytes = bytes;
+    entry.last_used_frame = static_index_frame_;
+    auto guest_indices = memory_.TranslatePhysical<const uint16_t*>(base);
+    bool is_reset_index_used, is_ffff_used_as_vertex_index;
+    Get16BitResetIndexUsage(guest_indices, count, reset_index_guest_endian, is_reset_index_used,
+                            is_ffff_used_as_vertex_index);
+    if (is_reset_index_used) {
+      entry.result.index_buffer_type = ProcessedIndexBufferType::kHostConverted;
+      entry.result.host_index_format =
+          is_ffff_used_as_vertex_index ? xenos::IndexFormat::kInt32 : xenos::IndexFormat::kInt16;
+      entry.content_hash = XXH3_64bits(guest_indices, size_t(count) * sizeof(uint16_t));
+      if (it != static_index_entries_.end() && !it->second.failed &&
+          it->second.persistent_handle != SIZE_MAX &&
+          it->second.reset_index_guest_endian == reset_index_guest_endian &&
+          it->second.result.host_index_format == entry.result.host_index_format &&
+          it->second.content_hash == entry.content_hash) {
+        // Registered again with the same indices: the earlier conversion still holds, and is
+        // handed over to the new entry.
+        entry.persistent_handle = it->second.persistent_handle;
+        it->second.persistent_handle = SIZE_MAX;
+      }
+    }
+    if (it != static_index_entries_.end()) {
+      StaticIndexEntry& old_entry = it->second;
+      if (old_entry.generation == generation) {
+        // The same registration (the reset index changed): native mesh draws learned from the
+        // old conversion may keep using it for as long as the range keeps its generation, so
+        // it is released together with the new entry.
+        entry.retired_handles = std::move(old_entry.retired_handles);
+        if (old_entry.persistent_handle != SIZE_MAX) {
+          entry.retired_handles.push_back(old_entry.persistent_handle);
+        }
+        old_entry.retired_handles.clear();
+        old_entry.persistent_handle = SIZE_MAX;
+      } else {
+        // The old conversion (if not handed over) holds different contents now. The backend
+        // keeps its space until the submissions that drew from it have completed.
+        ReleaseStaticIndexEntryBuffers(old_entry);
+      }
+    }
+    if (is_reset_index_used) {
+      if (entry.persistent_handle == SIZE_MAX) {
+        void* host_indices = RequestPersistentConvertedIndexBuffer(
+            entry.result.host_index_format, count, base, entry.persistent_handle);
+        if (!host_indices) {
+          // Remembered, so the indices are not scanned again on every draw (the draw is
+          // converted the usual way, per frame) until the range changes or space is freed.
+          entry.persistent_handle = SIZE_MAX;
+          entry.failed = true;
+          entry.failed_frees = persistent_index_buffer_frees_;
+          static_index_entries_.insert_or_assign(key, std::move(entry));
+          // Out of space: release the entries whose range is gone. Their space can't be reused
+          // before the current submission completes (native mesh draws may still read it), so
+          // this conversion is tried again once the backend has freed it. The trim keeps the
+          // new entry, as its range is registered.
+          MaybeTrimStaticIndexEntriesUnderPressure();
+          return false;
+        }
+        if (is_ffff_used_as_vertex_index) {
+          ReplaceResetIndex16To24(reinterpret_cast<uint32_t*>(host_indices), guest_indices, count,
+                                  reset_index_guest_endian);
+        } else {
+          ReplaceResetIndex16To16(reinterpret_cast<uint16_t*>(host_indices), guest_indices,
+                                  count, reset_index_guest_endian);
+        }
+      }
+      // The converted copy is drawn from instead of the guest memory, which is then never
+      // requested from the shared memory, so nothing else would watch it: without this, the
+      // game rewriting the indices in place (a level loaded over them) would go unseen and the
+      // old triangles would keep being drawn. The write faults, and the shared memory's
+      // invalidation callback forgets the range (native_ranges::InvalidateWritten).
+      memory_.EnablePhysicalMemoryAccessCallbacks(base, bytes, true, false);
+    }
+    it = static_index_entries_.insert_or_assign(key, std::move(entry)).first;
+    if (IsPersistentConvertedIndexBufferSpaceLow()) {
+      // Release forgotten entries ahead of time, so their space has been freed by the time it
+      // runs out. The trim keeps this entry, as its range is registered.
+      MaybeTrimStaticIndexEntriesUnderPressure();
+    }
+  }
+  if (it->second.failed) {
+    return false;
+  }
+  it->second.last_used_frame = static_index_frame_;
+  CachedResult found = it->second.result;
+  if (found.index_buffer_type == ProcessedIndexBufferType::kHostConverted) {
+    found.host_index_buffer_handle =
+        UsePersistentConvertedIndexBuffer(it->second.persistent_handle);
+    if (found.host_index_buffer_handle == SIZE_MAX) {
+      return false;
+    }
+  }
+  result = found;
+  return true;
+}
+
+void PrimitiveProcessor::AdvanceStaticIndexFrame() {
+  ++static_index_frame_;
+  if (static_index_entries_.empty()) {
+    return;
+  }
+  // Ranges are forgotten in bursts (a level unloading), so the entries are checked a while
+  // after the registered ranges changed, not on every frame.
+  constexpr uint32_t kTrimIntervalFrames = 60;
+  if (static_index_frame_ - static_index_last_trim_frame_ < kTrimIntervalFrames) {
+    return;
+  }
+  if (static_index_trim_pending_ ||
+      static_index_trim_removal_version_ != native_ranges::RemovalVersion()) {
+    TrimStaticIndexEntries(false);
+  }
+}
+
+void PrimitiveProcessor::MaybeTrimStaticIndexEntriesUnderPressure() {
+  // At most once a frame, and only if a range may have been forgotten since the last trim, or
+  // the last trim kept forgotten entries; otherwise there is nothing more to release.
+  if (static_index_last_pressure_trim_frame_ == static_index_frame_ ||
+      (!static_index_trim_pending_ &&
+       static_index_trim_removal_version_ == native_ranges::RemovalVersion())) {
+    return;
+  }
+  TrimStaticIndexEntries(true);
+}
+
+void PrimitiveProcessor::TrimStaticIndexEntries(bool under_pressure) {
+  // An entry whose range was forgotten is kept for a while: the game registers the range
+  // again when it draws it, and if the indices are the same, the conversion is reused
+  // (content_hash) instead of being redone.
+  // Entries whose range is still registered are never dropped, even if not drawn through
+  // here for a long time: the command processor's native mesh draws use the converted buffer
+  // directly, without primitive processing, for as long as the range keeps its generation.
+  constexpr uint32_t kForgottenKeepFrames = 300;
+  static_index_last_trim_frame_ = static_index_frame_;
+  static_index_trim_removal_version_ = native_ranges::RemovalVersion();
+  static_index_trim_pending_ = false;
+  if (under_pressure) {
+    static_index_last_pressure_trim_frame_ = static_index_frame_;
+  }
+  for (auto it = static_index_entries_.begin(); it != static_index_entries_.end();) {
+    StaticIndexEntry& entry = it->second;
+    const uint32_t unused_frames = static_index_frame_ - entry.last_used_frame;
+    bool drop;
+    if (native_ranges::Lookup(uint32_t(it->first >> 32), entry.bytes) ==
+               entry.generation) {
+      drop = false;
+    } else if (under_pressure || unused_frames >= kForgottenKeepFrames) {
+      drop = true;
+    } else {
+      drop = false;
+      static_index_trim_pending_ = true;
+    }
+    if (!drop) {
+      ++it;
+      continue;
+    }
+    ReleaseStaticIndexEntryBuffers(entry);
+    it = static_index_entries_.erase(it);
+  }
+}
+
+void PrimitiveProcessor::ReleaseStaticIndexEntryBuffers(StaticIndexEntry& entry) {
+  if (entry.persistent_handle != SIZE_MAX) {
+    ReleasePersistentConvertedIndexBuffer(entry.persistent_handle);
+    entry.persistent_handle = SIZE_MAX;
+  }
+  for (size_t retired_handle : entry.retired_handles) {
+    ReleasePersistentConvertedIndexBuffer(retired_handle);
+  }
+  entry.retired_handles.clear();
+}
