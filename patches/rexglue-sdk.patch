+void TextureCache::SetOwnScaleBase(uint32_t base, uint32_t scale_sixteenths) {
+  auto it = own_scale_bases_.find(base);
+  const uint32_t old_scale = it != own_scale_bases_.end() ? it->second : 0;
+  if (old_scale == scale_sixteenths) {
+    return;
+  }
+  if (scale_sixteenths) {
+    own_scale_bases_[base] = scale_sixteenths;
+  } else {
+    own_scale_bases_.erase(it);
+  }
+  // Lookups of that address give a different texture now (the memo, the native replays, the
+  // bindings).
+  ++texture_lookup_generation_;
+  ResetTextureBindings();
