+// The jitter sequence FSR 2 and 3 recommend: Halton(2, 3) in -0.5...0.5 of a render pixel, with
+// a period that grows with the area scale so every output pixel gets samples.
+float TemporalJitterHalton(uint32_t index, uint32_t base) {
+  float f = 1.0f, result = 0.0f;
+  while (index) {
+    f /= float(base);
+    result += f * float(index % base);
+    index /= base;
+  }
+  return result;
+}
