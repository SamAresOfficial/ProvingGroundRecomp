+  }
+  const uint32_t delta = source_info.base_tiles - owner.base_tiles;
+  // native_main_pass_scale_sixteenths: color and depth go straight into a texture at the
+  // render target's scale (through a buffer for the red/blue swap and the float24 depth).
+  const bool own_scale_texture = owner.own_scale_sixteenths && scale_x == 1 && scale_y == 1 &&
+                                 REXCVAR_GET(native_resolve_own_scale);
+  if (!texture_cache.CanResolveDirectlyToTexture(
+          resolve_info.copy_dest_base, resolve_info.coordinate_info.width_div_8 << 3,
+          resolve_info.height_div_8 << 3, dest_coordinates.pitch_aligned_div_32,
+          xenos::Endian(uint32_t(dest_info.copy_dest_endian)),
+          is_depth ? depth_texture_format : xenos::TextureFormat::k_8_8_8_8,
+          own_scale_texture)) {
