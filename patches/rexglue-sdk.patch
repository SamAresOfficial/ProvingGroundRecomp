+    // addBarrier): a view of the format the surface format maps back to, and a second one for
+    // writing if the usage has UAV (taken from VK_IMAGE_USAGE_STORAGE_BIT here), with the color
+    // aspect unless the usage has DEPTHTARGET, which makes it a D32_SFLOAT view and barrier of
+    // the depth aspect. The inputs are color images (the depth too, an R32_SFLOAT copy) that the
+    // upscaler only samples, so they are described as sampled, read-only color images.
+    constexpr VkImageUsageFlags kInputUsage = VK_IMAGE_USAGE_SAMPLED_BIT;
+    ffxDispatchDescUpscale dispatch_desc = {};
+    dispatch_desc.header.type = FFX_API_DISPATCH_DESC_TYPE_UPSCALE;
+    dispatch_desc.header.pNext = nullptr;
+    dispatch_desc.commandList = command_buffer;
+    dispatch_desc.color = GetTemporalUpscalerResource(
+        parameters.color, kGuestOutputFormat, parameters.render_extent,
