+    command_processor_.GpuTimingSequence(fmt::format(
+        "texture load {:08X} {}x{} format {} tiled {} pitch {} scaled {} base {} mips {}",
+        key.base_page << 12, key.width_minus_1 + 1, key.height_minus_1 + 1, uint32_t(key.format),
+        uint32_t(key.tiled), uint32_t(key.pitch), uint32_t(key.scaled_resolve), load_base,
+        load_mips));
+  }
+  // Render-to-texture targets (8888, no mips: what the game resolves) apart from the others.
+  const bool resolve_like = key.format == xenos::TextureFormat::k_8_8_8_8 && !key.mip_max_level;
+  command_processor_.GpuTimingMark(VulkanCommandProcessor::GpuTimingCategory::kOther);
+  const bool result = LoadTextureDataFromResidentMemoryImplInner(texture, load_base, load_mips);
+  command_processor_.GpuTimingMark(command_processor_.GpuTimingNamedCategory(
+      resolve_like ? "texture loads (resolved targets)" : "texture loads (other)"));
+  return result;
+}
+
+void VulkanTextureCache::LearnDirectResolveTexture(VulkanTexture& texture) {
+  const TextureKey& key = texture.key();
+  if (key.dimension != xenos::DataDimension::k2DOrStacked || key.depth_or_array_size_minus_1 ||
+      !key.tiled || key.mip_max_level || key.signed_separate || key.own_scale_sixteenths ||
+      bool(key.scaled_resolve) != IsDrawResolutionScaled()) {
+    return;
+  }
+  VkFormat expected_host_format;
+  if (key.format == xenos::TextureFormat::k_8_8_8_8) {
+    expected_host_format = VK_FORMAT_R8G8B8A8_UNORM;
+  } else if (key.format == xenos::TextureFormat::k_24_8_FLOAT ||
+             key.format == xenos::TextureFormat::k_24_8) {
+    // k_24_8: the unorm24 of the depth word (a float24 depth resolve sampled that way).
+    expected_host_format = VK_FORMAT_R32_SFLOAT;
+  } else {
+    return;
+  }
+  const uint32_t base = key.base_page << 12;
+  if (std::find(direct_resolve_blocked_.begin(), direct_resolve_blocked_.end(), base) !=
+          direct_resolve_blocked_.end() ||
+      GetHostFormatPair(key).format_unsigned.format != expected_host_format) {
+    return;
+  }
+  direct_resolve_textures_[base] = &texture;
+}
+
+bool VulkanTextureCache::CanResolveDirectlyToTexture(uint32_t dest_base, uint32_t width,
+                                                     uint32_t height, uint32_t pitch_div_32,
+                                                     xenos::Endian endian,
+                                                     xenos::TextureFormat format,
+                                                     bool own_scale) {
+  auto it = direct_resolve_textures_.find(dest_base);
+  if (it == direct_resolve_textures_.end()) {
+    return false;
+  }
+  const VulkanTexture& texture = *it->second;
+  const TextureKey& key = texture.key();
+  const uint32_t texture_width = key.width_minus_1 + 1;
+  const uint32_t texture_height = key.height_minus_1 + 1;
+  // The resolve must be exactly the texture (it is 8-aligned: for a texture smaller than the
+  // rectangle, the usual resolve also writes EDRAM pixels past the texture into memory, which
+  // the texture could not give back when written back, so such a resolve is done the usual
+  // way), and the texture must be current (else a load would overwrite the copy).
+  if (!(texture_width == width && texture_height == height && key.pitch == pitch_div_32 &&
+        key.endianness == endian &&
+        (key.format == format || (format == xenos::TextureFormat::k_24_8_FLOAT &&
+                                  key.format == xenos::TextureFormat::k_24_8)) &&
+        (own_scale || !texture.outdated_mask()) &&
+        std::find(direct_resolve_blocked_.begin(), direct_resolve_blocked_.end(), dest_base) ==
+            direct_resolve_blocked_.end())) {
+    return false;
+  }
+  // Only if the data can be given to shared memory later, when something else reads the range.
+  if (!EnsureDirectResolveWriteBackPass()) {
+    return false;
+  }
+  direct_resolve_checked_width_ = width;
+  direct_resolve_checked_height_ = height;
+  return true;
+}
+
+void VulkanTextureCache::ResolveDirectlyToTexture(uint32_t dest_base, VkImage source,
+                                                  int32_t source_x, int32_t source_y,
+                                                  uint32_t fill_x, uint32_t fill_y,
+                                                  uint32_t range_start, uint32_t range_length) {
+  BeginDirectResolve(range_start, range_length);
+  VulkanTexture& texture = *direct_resolve_textures_.find(dest_base)->second;
+  const TextureKey& key = texture.key();
+  texture.MarkAsUsed();
+  VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kTransferDestination);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kTransferDestination, dst_stage_mask,
+                       dst_access_mask, new_layout);
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+      dst_stage_mask, src_access_mask, dst_access_mask, old_layout, new_layout);
+  command_processor_.SubmitBarriers(true);
+  const uint32_t width = (key.width_minus_1 + 1) * (key.scaled_resolve ? draw_resolution_scale_x() : 1);
+  const uint32_t height =
+      (key.height_minus_1 + 1) * (key.scaled_resolve ? draw_resolution_scale_y() : 1);
+  // The covered part, then the half-pixel offset gap (if any) from the first covered column /
+  // row, with no region written twice.
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  auto copy = [&](uint32_t dest_x, uint32_t dest_y, uint32_t copy_width, uint32_t copy_height) {
+    VkImageCopy region = {};
+    region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.srcSubresource.layerCount = 1;
+    region.srcOffset.x = source_x + int32_t(dest_x < fill_x ? fill_x : dest_x);
+    region.srcOffset.y = source_y + int32_t(dest_y < fill_y ? fill_y : dest_y);
+    region.dstSubresource = region.srcSubresource;
+    region.dstOffset.x = int32_t(dest_x);
+    region.dstOffset.y = int32_t(dest_y);
+    region.extent.width = copy_width;
+    region.extent.height = copy_height;
+    region.extent.depth = 1;
+    command_buffer.CmdVkCopyImage(source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, texture.image(),
+                                  VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region);
+  };
+  copy(fill_x, fill_y, width - fill_x, height - fill_y);
+  for (uint32_t x = 0; x < fill_x; ++x) {
+    copy(x, fill_y, 1, height - fill_y);
+  }
+  for (uint32_t y = 0; y < fill_y; ++y) {
+    copy(fill_x, y, width - fill_x, 1);
+    for (uint32_t x = 0; x < fill_x; ++x) {
+      copy(x, y, 1, 1);
+    }
+  }
+  EndDirectResolve(texture, dest_base, range_start, range_length);
+}
+
+bool VulkanTextureCache::ResolveDirectlyToOwnScaleTexture(
+    uint32_t dest_base, VkImage source, int32_t source_x, int32_t source_y,
+    uint32_t source_width, uint32_t source_height, uint32_t scale_sixteenths,
+    uint32_t range_start, uint32_t range_length) {
+  VulkanTexture& unscaled_texture = *direct_resolve_textures_.find(dest_base)->second;
+  TextureKey key = unscaled_texture.key();
+  key.own_scale_sixteenths = scale_sixteenths;
+  VulkanTexture* texture_ptr = static_cast<VulkanTexture*>(FindOrCreateTexture(key));
+  if (!texture_ptr) {
+    return false;
+  }
+  VulkanTexture& texture = *texture_ptr;
+  BeginDirectResolve(range_start, range_length);
+  // The unscaled one stays learned (it is not sampled while this one is current).
+  unscaled_texture.MarkAsUsed();
+  texture.MarkAsUsed();
+  VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kTransferDestination);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kTransferDestination, dst_stage_mask,
+                       dst_access_mask, new_layout);
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+      dst_stage_mask, src_access_mask, dst_access_mask, old_layout, new_layout);
+  command_processor_.SubmitBarriers(true);
+  const uint32_t width = std::max(key.GetWidth() * scale_sixteenths / 16, UINT32_C(1));
+  const uint32_t height = std::max(key.GetHeight() * scale_sixteenths / 16, UINT32_C(1));
+  VkImageCopy region = {};
+  region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  region.srcSubresource.layerCount = 1;
+  region.srcOffset.x = source_x;
+  region.srcOffset.y = source_y;
+  region.dstSubresource = region.srcSubresource;
+  region.extent.width = std::min(width, source_width - uint32_t(source_x));
+  region.extent.height = std::min(height, source_height - uint32_t(source_y));
+  region.extent.depth = 1;
+  command_processor_.deferred_command_buffer().CmdVkCopyImage(
+      source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, texture.image(),
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region);
+  // The unscaled texture and the others over the range become outdated, this one current.
+  EndDirectResolve(texture, dest_base, range_start, range_length);
+  SetOwnScaleBase(dest_base, scale_sixteenths);
+  ++own_scale_resolve_count_;
+  if (command_processor_.IsGpuTimingSequenceActive()) {
+    command_processor_.GpuTimingSequence(
+        fmt::format("own-scale resolve {:08X} {}x{} at {}/16", dest_base, key.GetWidth(),
+                    key.GetHeight(), scale_sixteenths));
+  }
+  return true;
+}
+
+bool VulkanTextureCache::ResolveThroughBufferToTexture(uint32_t dest_base, VkImage source,
+                                                       int32_t source_x, int32_t source_y,
+                                                       uint32_t fill_x, uint32_t fill_y,
+                                                       bool is_depth, bool round_to_nearest_even,
+                                                       uint32_t range_start,
+                                                       uint32_t range_length,
+                                                       uint32_t own_scale_sixteenths,
+                                                       uint32_t source_width,
+                                                       uint32_t source_height,
+                                                       uint32_t depth_source_kind) {
+  if (!EnsureDepthFloat24Pass()) {
+    return false;
+  }
+  VulkanTexture* texture_ptr = direct_resolve_textures_.find(dest_base)->second;
+  const TextureKey& key = texture_ptr->key();
+  uint32_t width = (key.width_minus_1 + 1) * (key.scaled_resolve ? draw_resolution_scale_x() : 1);
+  uint32_t height =
+      (key.height_minus_1 + 1) * (key.scaled_resolve ? draw_resolution_scale_y() : 1);
+  if (own_scale_sixteenths) {
+    // native_main_pass_scale_sixteenths: into the texture at the render target's own scale
+    // (source_x/y and source_width/height in its pixels), as ResolveDirectlyToOwnScaleTexture.
+    TextureKey own_scale_key = key;
+    own_scale_key.own_scale_sixteenths = own_scale_sixteenths;
+    VulkanTexture* own_scale_texture =
+        static_cast<VulkanTexture*>(FindOrCreateTexture(own_scale_key));
+    if (!own_scale_texture) {
+      return false;
+    }
+    texture_ptr->MarkAsUsed();
+    texture_ptr = own_scale_texture;
+    width = std::min(std::max(own_scale_key.GetWidth() * own_scale_sixteenths / 16, UINT32_C(1)),
+                     source_width - uint32_t(source_x));
+    height =
+        std::min(std::max(own_scale_key.GetHeight() * own_scale_sixteenths / 16, UINT32_C(1)),
+                 source_height - uint32_t(source_y));
+    fill_x = 0;
+    fill_y = 0;
+  }
+  VulkanTexture& texture = *texture_ptr;
+  // Before the scratch buffer is taken: writing an earlier resolve back uses it too.
+  BeginDirectResolve(range_start, range_length);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  VulkanCommandProcessor::ScratchBufferAcquisition scratch(
+      command_processor_.AcquireScratchGpuBuffer(VkDeviceSize(width) * height * sizeof(float),
+                                                 VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                                 VK_ACCESS_TRANSFER_WRITE_BIT));
+  if (scratch.buffer() == VK_NULL_HANDLE) {
+    return false;
+  }
+  command_processor_.SubmitBarriers(true);
+  VkBufferImageCopy region = {};
+  region.imageSubresource.aspectMask =
+      is_depth ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT;
+  region.imageSubresource.layerCount = 1;
+  region.imageOffset.x = source_x;
+  region.imageOffset.y = source_y;
+  region.imageExtent.width = width;
+  region.imageExtent.height = height;
+  region.imageExtent.depth = 1;
+  command_buffer.CmdVkCopyImageToBuffer(source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                        scratch.buffer(), region);
+  // To float24 and back, in place.
+  const uint32_t texel_count = width * height;
+  VkDescriptorSet descriptor_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (!descriptor_set) {
+    return false;
+  }
+  {
+    const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+    VkDescriptorBufferInfo buffer_info;
+    buffer_info.buffer = scratch.buffer();
+    buffer_info.offset = 0;
+    buffer_info.range = VkDeviceSize(texel_count) * sizeof(uint32_t);
+    VkWriteDescriptorSet write = {};
+    write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    write.dstSet = descriptor_set;
+    write.dstBinding = 0;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    write.pBufferInfo = &buffer_info;
+    vulkan_device->functions().vkUpdateDescriptorSets(vulkan_device->device(), 1, &write, 0,
+                                                      nullptr);
+  }
+  command_processor_.PushBufferMemoryBarrier(
+      scratch.buffer(), 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+  command_processor_.SubmitBarriers(true);
+  command_processor_.BindExternalComputePipeline(depth_float24_pass_pipeline_);
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         depth_float24_pass_layout_, 0, 1, &descriptor_set, 0,
+                                         nullptr);
+  const uint32_t push_constants[3] = {
+      texel_count, uint32_t(round_to_nearest_even),
+      !is_depth ? 1u
+      : depth_source_kind == kDepthSourceUnorm24AsFloat32 ? 3u
+      : depth_source_kind == kDepthSourceUnorm24          ? 4u
+      : key.format == xenos::TextureFormat::k_24_8        ? 2u
+                                                          : 0u};
+  command_buffer.CmdVkPushConstants(depth_float24_pass_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    sizeof(push_constants), push_constants);
+  command_buffer.CmdVkDispatch((texel_count + 63) / 64, 1, 1);
+  command_processor_.PushBufferMemoryBarrier(
+      scratch.buffer(), 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+  scratch.SetStageMask(VK_PIPELINE_STAGE_TRANSFER_BIT);
+  scratch.SetAccessMask(VK_ACCESS_TRANSFER_READ_BIT);
+  texture.MarkAsUsed();
+  VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kTransferDestination);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kTransferDestination, dst_stage_mask,
+                       dst_access_mask, new_layout);
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+      dst_stage_mask, src_access_mask, dst_access_mask, old_layout, new_layout);
+  command_processor_.SubmitBarriers(true);
+  // The covered part, then the half-pixel offset gap (if any) from the first covered column /
+  // row of the buffer, with no region written twice.
+  VkBufferImageCopy regions[1 + 2 * 2 + 2 * 2];
+  uint32_t region_count = 0;
+  auto add_region = [&](uint32_t dest_x, uint32_t dest_y, uint32_t copy_width,
+                        uint32_t copy_height) {
+    VkBufferImageCopy& dest_region = regions[region_count++];
+    dest_region = {};
+    const uint32_t buffer_x = dest_x < fill_x ? fill_x : dest_x;
+    const uint32_t buffer_y = dest_y < fill_y ? fill_y : dest_y;
+    dest_region.bufferOffset = (VkDeviceSize(buffer_y) * width + buffer_x) * sizeof(uint32_t);
+    dest_region.bufferRowLength = width;
+    dest_region.bufferImageHeight = height;
+    dest_region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    dest_region.imageSubresource.layerCount = 1;
+    dest_region.imageOffset.x = int32_t(dest_x);
+    dest_region.imageOffset.y = int32_t(dest_y);
+    dest_region.imageExtent.width = copy_width;
+    dest_region.imageExtent.height = copy_height;
+    dest_region.imageExtent.depth = 1;
+  };
+  add_region(fill_x, fill_y, width - fill_x, height - fill_y);
+  for (uint32_t x = 0; x < fill_x; ++x) {
+    add_region(x, fill_y, 1, height - fill_y);
+  }
+  for (uint32_t y = 0; y < fill_y; ++y) {
+    add_region(fill_x, y, width - fill_x, 1);
+    for (uint32_t x = 0; x < fill_x; ++x) {
+      add_region(x, y, 1, 1);
+    }
+  }
+  command_buffer.CmdVkCopyBufferToImage(scratch.buffer(), texture.image(),
+                                        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region_count,
+                                        regions);
+  EndDirectResolve(texture, dest_base, range_start, range_length);
+  if (own_scale_sixteenths) {
+    SetOwnScaleBase(dest_base, own_scale_sixteenths);
+    ++own_scale_resolve_count_;
+    if (command_processor_.IsGpuTimingSequenceActive()) {
+      command_processor_.GpuTimingSequence(fmt::format(
+          "own-scale resolve {:08X} {}x{} at {}/16 ({})", dest_base, key.GetWidth(),
+          key.GetHeight(), own_scale_sixteenths,
+          is_depth ? "depth" : "red/blue swapped"));
+    }
+  }
+  return true;
+}
+
+bool VulkanTextureCache::EnsureDepthFloat24Pass() {
+  if (depth_float24_pass_pipeline_ != VK_NULL_HANDLE) {
+    return true;
+  }
+  if (depth_float24_pass_tried_) {
+    return false;
+  }
+  depth_float24_pass_tried_ = true;
+  // Float32To20e4 and Float20e4To32 from xenos.cpp.
+  static const char kSource[] = R"(#version 450
+layout(local_size_x = 64) in;
+layout(push_constant) uniform Constants {
+  uint texel_count;
+  uint round_to_nearest_even;
+  // 0: depth through float24 (k_24_8_FLOAT); 1: red/blue swap; 2: depth as the unorm24 of its
+  // float24 bits (k_24_8 sampled from a float24 depth resolve); 3: unorm24 depth kept as
+  // float32, rounded to 24 bits (k_24_8); 4: D24 unorm words (k_24_8).
+  uint mode;
+} constants;
+layout(set = 0, binding = 0, std430) buffer Texels { uint texels[]; };
+uint ToFloat24(uint u) {
+  if (!(uintBitsToFloat(u) > 0.0)) {
+    return 0u;
+  }
+  if (u >= 0x3FFFFFF8u) {
+    return 0xFFFFFFu;
+  }
+  if (u < 0x38800000u) {
+    uint shift = min(113u - (u >> 23u), 24u);
+    u = (0x800000u | (u & 0x7FFFFFu)) >> shift;
+  } else {
+    u += 0xC8000000u;
+  }
+  if (constants.round_to_nearest_even != 0u) {
+    u += 3u + ((u >> 3u) & 1u);
+  }
+  return (u >> 3u) & 0xFFFFFFu;
+}
+uint FromFloat24(uint f24) {
+  if (f24 == 0u) {
+    return 0u;
+  }
+  uint mantissa = f24 & 0xFFFFFu;
+  int exponent = int(f24 >> 20u);
+  if (exponent == 0) {
+    int lzcnt = 20 - findMSB(mantissa);
+    exponent = 1 - lzcnt;
+    mantissa = (mantissa << uint(lzcnt)) & 0xFFFFFu;
+  }
+  return (uint(exponent + 112) << 23u) | (mantissa << 3u);
+}
+void main() {
+  uint i = gl_GlobalInvocationID.x;
+  if (i < constants.texel_count) {
+    uint texel = texels[i];
+    if (constants.mode == 1u) {
+      texels[i] = (texel & 0xFF00FF00u) | ((texel & 0xFFu) << 16u) | ((texel >> 16u) & 0xFFu);
+    } else if (constants.mode == 2u) {
+      texels[i] = floatBitsToUint(float(ToFloat24(texel)) * (1.0 / 16777215.0));
+    } else if (constants.mode == 3u) {
+      uint unorm24 = uint(clamp(uintBitsToFloat(texel), 0.0, 1.0) * 16777215.0 + 0.5);
+      texels[i] = floatBitsToUint(float(unorm24) * (1.0 / 16777215.0));
+    } else if (constants.mode == 4u) {
+      texels[i] = floatBitsToUint(float(texel & 0xFFFFFFu) * (1.0 / 16777215.0));
+    } else {
+      texels[i] = FromFloat24(ToFloat24(texel));
+    }
+  }
+}
+)";
+  std::vector<uint32_t> spirv;
+  std::string error;
+  if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, kSource, spirv, error)) {
+    REXGPU_ERROR("Direct resolve: buffer pass: {}", error);
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkDescriptorSetLayout set_layout = command_processor_.GetSingleTransientDescriptorLayout(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  VkPushConstantRange push_constant_range;
+  push_constant_range.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+  push_constant_range.offset = 0;
+  push_constant_range.size = sizeof(uint32_t) * 3;
+  VkPipelineLayoutCreateInfo layout_create_info = {};
+  layout_create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+  layout_create_info.setLayoutCount = 1;
+  layout_create_info.pSetLayouts = &set_layout;
+  layout_create_info.pushConstantRangeCount = 1;
+  layout_create_info.pPushConstantRanges = &push_constant_range;
+  if (dfn.vkCreatePipelineLayout(vulkan_device->device(), &layout_create_info, nullptr,
+                                 &depth_float24_pass_layout_) != VK_SUCCESS) {
+    depth_float24_pass_layout_ = VK_NULL_HANDLE;
+    return false;
+  }
+  depth_float24_pass_pipeline_ = ui::vulkan::util::CreateComputePipeline(
+      vulkan_device, depth_float24_pass_layout_, spirv.data(), spirv.size() * sizeof(uint32_t));
+  return depth_float24_pass_pipeline_ != VK_NULL_HANDLE;
+}
+
+void VulkanTextureCache::NotifyUsualResolve(uint32_t start, uint32_t length) {
+  // The same range is replaced as a whole. Anything else overlapping it gets its texture's
+  // data first, as the resolve may leave a part of it as it is.
+  FlushDirectResolveRanges(start, length, true);
+}
+
+bool VulkanTextureCache::WriteBackDirectResolves(uint32_t start, uint32_t length) {
+  return FlushDirectResolveRanges(start, length, false);
+}
+
+void VulkanTextureCache::GetDirectResolveImageSize(const TextureKey& key, uint32_t& width_out,
+                                                   uint32_t& height_out) const {
+  // As CreateTexture.
+  width_out = key.GetWidth();
+  height_out = key.GetHeight();
+  if (key.scaled_resolve) {
+    width_out *= draw_resolution_scale_x();
+    height_out *= draw_resolution_scale_y();
+  }
+  if (key.own_scale_sixteenths) {
+    width_out = std::max(width_out * key.own_scale_sixteenths / 16, UINT32_C(1));
+    height_out = std::max(height_out * key.own_scale_sixteenths / 16, UINT32_C(1));
+  }
+}
+
+void VulkanTextureCache::BeginDirectResolve(uint32_t range_start, uint32_t range_length) {
+  // The resolve replaces the range if it is the same one. Anything else there is written back.
+  FlushDirectResolveRanges(range_start, range_length, true);
+  if (!IsDrawResolutionScaled()) {
+    // As before the usual resolve: pages the resolve covers only partly keep their other
+    // data, and the host memory is there for the write-back.
+    shared_memory().RequestRange(range_start, range_length);
+  }
+}
+
+void VulkanTextureCache::WriteBackAgedDirectResolves() {
+  direct_resolve_aged_check_frame_ = direct_resolve_frame_;
+  // The textures of tracked ranges are never dropped as unused (MustKeepUnusedTexture), so
+  // ranges the game has stopped resolving into are written back here, whether or not another
+  // direct resolve ever comes, and their textures can go as any other then.
+  for (size_t i = 0; i < direct_resolve_ranges_.size();) {
+    const DirectResolveRange range = direct_resolve_ranges_[i];
+    if (direct_resolve_frame_ - range.frame <= kDirectResolveRangeMaxAgeFrames) {
+      ++i;
+      continue;
+    }
+    // Removes it, and possibly others.
+    FlushDirectResolveRanges(range.start, range.length, false);
+    i = 0;
+  }
+}
+
+bool VulkanTextureCache::MustKeepUnusedTexture(const Texture& texture) const {
+  for (const DirectResolveRange& range : direct_resolve_ranges_) {
+    if (range.texture == &texture) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void VulkanTextureCache::EndDirectResolve(VulkanTexture& texture, uint32_t dest_base,
+                                          uint32_t range_start, uint32_t range_length) {
+  DirectResolveRange range;
+  range.start = range_start;
+  range.length = range_length;
+  range.base = dest_base;
+  range.texture = &texture;
+  range.width = direct_resolve_checked_width_;
+  range.height = direct_resolve_checked_height_;
+  range.frame = direct_resolve_frame_;
+  direct_resolve_ranges_.push_back(range);
+  // As after the usual resolve: the pages are valid, GPU-written and protected (so a CPU write
+  // outdates the texture), the scaled pages marked, the other textures over the range
+  // outdated. Shared memory does not have the data, but hands the pages out only after the
+  // write-back.
+  InvalidateRangeExcept(texture, range_start, range_length);
+  UpdateDeferredGpuWriteRanges();
+  ++direct_resolve_stats_[0];
+}
+
+void VulkanTextureCache::UpdateDeferredGpuWriteRanges() {
+  VulkanSharedMemory& vulkan_shared_memory = static_cast<VulkanSharedMemory&>(shared_memory());
+  // Data for the scaled resolve buffer is asked for by texture loads and resolves, not by
+  // shared memory requests.
+  std::pair<uint32_t, uint32_t> ranges[16];
+  std::vector<std::pair<uint32_t, uint32_t>> more_ranges;
+  size_t count = 0;
+  for (const DirectResolveRange& range : direct_resolve_ranges_) {
+    if (range.texture->key().scaled_resolve) {
+      continue;
+    }
+    if (count < rex::countof(ranges)) {
+      ranges[count++] = std::make_pair(range.start, range.length);
+    } else {
+      if (more_ranges.empty()) {
+        more_ranges.assign(ranges, ranges + count);
+      }
+      more_ranges.emplace_back(range.start, range.length);
+    }
+  }
+  vulkan_shared_memory.SetDeferredGpuWriteCallback(DeferredGpuWriteCallbackThunk, this);
+  if (!more_ranges.empty()) {
+    vulkan_shared_memory.SetDeferredGpuWriteRanges(more_ranges.data(), more_ranges.size());
+  } else {
+    vulkan_shared_memory.SetDeferredGpuWriteRanges(ranges, count);
+  }
+}
+
+void VulkanTextureCache::DeferredGpuWriteCallbackThunk(void* context, uint32_t start,
+                                                       uint32_t length) {
+  static_cast<VulkanTextureCache*>(context)->FlushDirectResolveRanges(start, length, false);
+}
+
+bool VulkanTextureCache::FlushDirectResolveRanges(uint32_t start, uint32_t length,
+                                                  bool overwritten) {
+  if (direct_resolve_ranges_.empty() || !length) {
+    return false;
+  }
+  // Whole 4 KB pages, the granularity of the scaled resolve pages (shared memory asks with
+  // its own pages already).
+  const uint64_t flush_first = start & ~UINT32_C(0xFFF);
+  const uint64_t flush_end = rex::align(uint64_t(start) + length, uint64_t(0x1000));
+  bool any_written = false;
+  bool any_removed = false;
+  for (size_t i = 0; i < direct_resolve_ranges_.size();) {
+    const DirectResolveRange range = direct_resolve_ranges_[i];
+    if (range.start >= flush_end || uint64_t(range.start) + range.length <= flush_first) {
+      ++i;
+      continue;
+    }
+    direct_resolve_ranges_[i] = direct_resolve_ranges_.back();
+    direct_resolve_ranges_.pop_back();
+    any_removed = true;
+    if (overwritten && range.start == start && range.length == length) {
+      continue;
+    }
+    any_written |= WriteBackOrInvalidateDirectResolve(range);
+  }
+  if (any_removed) {
+    UpdateDeferredGpuWriteRanges();
+  }
+  return any_written;
+}
+
+bool VulkanTextureCache::WriteBackOrInvalidateDirectResolve(const DirectResolveRange& range) {
+  if (WriteBackDirectResolve(range)) {
+    ++direct_resolve_stats_[1];
+    if (command_processor_.IsGpuTimingSequenceActive()) {
+      command_processor_.GpuTimingSequence(
+          fmt::format("direct resolve {:08X} written back to memory ({}x{})", range.base,
+                      range.width, range.height));
+    }
+    return true;
+  }
+  // Should not happen (no scratch buffer or descriptor). The pages are given back to the CPU's
+  // copy, so nothing reads them as if they held the resolve, the texture becomes outdated, and
+  // the address is resolved the usual way from now on.
+  REXGPU_WARN(
+      "Direct resolve: failed to write {:08X} back to memory, resolving it the usual way from "
+      "now on",
+      range.base);
+  if (std::find(direct_resolve_blocked_.begin(), direct_resolve_blocked_.end(), range.base) ==
+      direct_resolve_blocked_.end()) {
+    direct_resolve_blocked_.push_back(range.base);
+  }
+  shared_memory().MemoryInvalidationCallback(range.start, range.length, true);
+  return false;
+}
+
+void VulkanTextureCache::OnDirectResolveTextureDestroyed(VulkanTexture& texture) {
+  bool any_removed = false;
+  for (size_t i = 0; i < direct_resolve_ranges_.size();) {
+    const DirectResolveRange range = direct_resolve_ranges_[i];
+    if (range.texture != &texture) {
+      ++i;
+      continue;
+    }
+    direct_resolve_ranges_[i] = direct_resolve_ranges_.back();
+    direct_resolve_ranges_.pop_back();
+    any_removed = true;
+    if (shutting_down_) {
+      continue;
+    }
+    // The only copy of the resolve goes with the texture (it was not used for long, or
+    // everything is being cleared): the pages are given back to the CPU's copy.
+    REXGPU_WARN("Direct resolve: the texture holding {:08X} is destroyed, its data is dropped",
+                range.base);
+    shared_memory().MemoryInvalidationCallback(range.start, range.length, true);
+  }
+  if (any_removed && !shutting_down_) {
+    UpdateDeferredGpuWriteRanges();
+  }
+}
+
+bool VulkanTextureCache::WriteBackDirectResolve(const DirectResolveRange& range) {
+  if (!EnsureDirectResolveWriteBackPass()) {
+    return false;
+  }
+  VulkanTexture& texture = *range.texture;
+  const TextureKey& key = texture.key();
+  const VulkanTexture::Usage texture_usage = texture.usage();
+  if (texture_usage == VulkanTexture::Usage::kUndefined) {
+    return false;
+  }
+  const bool scaled = key.scaled_resolve;
+  const uint32_t scale_x = scaled ? draw_resolution_scale_x() : 1;
+  const uint32_t scale_y = scaled ? draw_resolution_scale_y() : 1;
+  uint32_t source_width, source_height;
+  GetDirectResolveImageSize(key, source_width, source_height);
+
+  // The destination: bound from the texture's base to the end of the resolve's extent, as the
+  // usual resolve binds it.
+  VulkanSharedMemory& vulkan_shared_memory = static_cast<VulkanSharedMemory&>(shared_memory());
+  const uint32_t dest_length_unscaled = range.start - range.base + range.length;
+  uint64_t dest_offset = range.base;
+  uint64_t dest_length = dest_length_unscaled;
+  uint64_t dest_use_start = range.start;
+  uint64_t dest_use_length = range.length;
+  if (scaled) {
+    if (!GetScaledResolveRange(range.base, dest_length_unscaled, 2, dest_offset, dest_length) ||
+        !GetScaledResolveRange(range.start, range.length, 2, dest_use_start, dest_use_length) ||
+        !CommitScaledResolveRange(range.base, dest_length_unscaled, 2)) {
+      return false;
+    }
+  } else {
+    if (!vulkan_shared_memory.PrepareDeferredGpuWrite(range.start, range.length)) {
+      return false;
+    }
+  }
+
+  const VkDeviceSize source_size = VkDeviceSize(source_width) * source_height * sizeof(uint32_t);
+  VulkanCommandProcessor::ScratchBufferAcquisition scratch(
+      command_processor_.AcquireScratchGpuBuffer(source_size, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                                 VK_ACCESS_TRANSFER_WRITE_BIT));
+  if (scratch.buffer() == VK_NULL_HANDLE) {
+    return false;
+  }
+  VkDescriptorSet descriptor_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferPairCompute);
+  if (descriptor_set == VK_NULL_HANDLE) {
+    return false;
+  }
+  {
+    const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+    VkDescriptorBufferInfo buffer_infos[2];
+    buffer_infos[0].buffer = scratch.buffer();
+    buffer_infos[0].offset = 0;
+    buffer_infos[0].range = source_size;
+    buffer_infos[1].buffer = scaled ? scaled_resolve_buffer_ : vulkan_shared_memory.buffer();
+    buffer_infos[1].offset = dest_offset;
+    buffer_infos[1].range = dest_length;
+    VkWriteDescriptorSet writes[2] = {};
+    for (uint32_t i = 0; i < 2; ++i) {
+      writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+      writes[i].dstSet = descriptor_set;
+      writes[i].dstBinding = i;
+      writes[i].descriptorCount = 1;
+      writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+      writes[i].pBufferInfo = &buffer_infos[i];
+    }
+    vulkan_device->functions().vkUpdateDescriptorSets(vulkan_device->device(), 2, writes, 0,
+                                                      nullptr);
+  }
+
+  // The image into the scratch buffer. The texture's usage is not changed for the rest of the
+  // frame (draws replayed with cached bindings do not check it): the image goes back to it
+  // right after the copy. It is used by this submission, so it must outlive it.
+  texture.MarkAsUsed();
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  VkPipelineStageFlags texture_stage_mask;
+  VkAccessFlags texture_access_mask;
+  VkImageLayout texture_layout;
+  GetTextureUsageMasks(texture_usage, texture_stage_mask, texture_access_mask, texture_layout);
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(), texture_stage_mask,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, texture_access_mask, VK_ACCESS_TRANSFER_READ_BIT,
+      texture_layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+  VkBufferImageCopy region = {};
+  region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  region.imageSubresource.layerCount = 1;
+  region.imageExtent.width = source_width;
+  region.imageExtent.height = source_height;
+  region.imageExtent.depth = 1;
+  command_buffer.CmdVkCopyImageToBuffer(texture.image(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                        scratch.buffer(), region);
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(),
+      VK_PIPELINE_STAGE_TRANSFER_BIT, texture_stage_mask, VK_ACCESS_TRANSFER_READ_BIT,
+      texture_access_mask, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, texture_layout);
+  command_processor_.PushBufferMemoryBarrier(
+      scratch.buffer(), 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_ACCESS_SHADER_READ_BIT);
+  scratch.SetStageMask(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
+  scratch.SetAccessMask(VK_ACCESS_SHADER_READ_BIT);
+
+  // The buffer into guest memory.
+  if (scaled) {
+    UseScaledResolveBufferForWrite(dest_use_start, dest_use_length);
+  } else {
+    vulkan_shared_memory.Use(VulkanSharedMemory::Usage::kComputeWrite,
+                             std::make_pair(range.start, range.length));
+  }
+  struct WriteBackConstants {
+    uint32_t source_size[2];
+    uint32_t dest_size[2];
+    uint32_t dest_scale[2];
+    float source_per_guest[2];
+    uint32_t pitch;
+    uint32_t endian;
+    uint32_t format;
+    uint32_t filter_mode;
+    uint32_t dest_word_count;
+  } constants;
+  static_assert(sizeof(WriteBackConstants) == kDirectResolveWriteBackConstantsSize);
+  constants.source_size[0] = source_width;
+  constants.source_size[1] = source_height;
+  constants.dest_size[0] = range.width * scale_x;
+  constants.dest_size[1] = range.height * scale_y;
+  constants.dest_scale[0] = scale_x;
+  constants.dest_scale[1] = scale_y;
+  constants.source_per_guest[0] = float(source_width) / float(key.GetWidth());
+  constants.source_per_guest[1] = float(source_height) / float(key.GetHeight());
+  constants.pitch = uint32_t(key.pitch) << 5;
+  constants.endian = uint32_t(key.endianness);
+  const bool is_depth = key.format != xenos::TextureFormat::k_8_8_8_8;
+  constants.format = !is_depth ? 0 : key.format == xenos::TextureFormat::k_24_8_FLOAT ? 1 : 2;
+  // A texture at its own scale is brought to guest size the way the copy into the unscaled
+  // twin of its render target is (a linear blit for color, the nearest texel for depth).
+  constants.filter_mode = !key.own_scale_sixteenths ? 0 : is_depth ? 2 : 1;
+  constants.dest_word_count = uint32_t(std::min(dest_length >> 2, uint64_t(UINT32_MAX)));
+  command_processor_.BindExternalComputePipeline(direct_resolve_write_back_pass_pipeline_);
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         direct_resolve_write_back_pass_layout_, 0, 1,
+                                         &descriptor_set, 0, nullptr);
+  command_buffer.CmdVkPushConstants(direct_resolve_write_back_pass_layout_,
+                                    VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants),
+                                    &constants);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkDispatch((constants.dest_size[0] + 7) / 8, (constants.dest_size[1] + 7) / 8,
+                               1);
+  return true;
+}
+
+bool VulkanTextureCache::EnsureDirectResolveWriteBackPass() {
+  if (direct_resolve_write_back_pass_pipeline_ != VK_NULL_HANDLE) {
+    return true;
+  }
+  if (direct_resolve_write_back_pass_tried_) {
+    return false;
+  }
+  direct_resolve_write_back_pass_tried_ = true;
+  static const char kSource[] = R"(#version 450
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(push_constant) uniform Constants {
+  // Texels of the texture image, as copied into the source buffer (rows of source_size.x).
+  uvec2 source_size;
+  // Texels to write: the resolve rectangle in guest pixels times dest_scale.
+  uvec2 dest_size;
+  // Draw resolution scale of the destination (the scaled resolve buffer), 1 for shared memory.
+  uvec2 dest_scale;
+  // Source texels per guest pixel, for the filters 1 and 2.
+  vec2 source_per_guest;
+  // Guest row pitch in texels, a multiple of 32.
+  uint pitch;
+  // xenos::Endian of the guest texture.
+  uint endian;
+  // 0: 8888 words; 1: float32 depth to the float24 depth word (k_24_8_FLOAT); 2: float32
+  // holding unorm24 depth to the depth word (k_24_8).
+  uint format;
+  // 0: the destination texel is the source texel (clamped to the source); 1: 8888 filtered
+  // linearly (a texture at its own scale to guest size, as a linear blit); 2: the nearest
+  // source texel (depth at its own scale).
+  uint filter_mode;
+  // Size of the destination binding in 32-bit words.
+  uint dest_word_count;
+} constants;
+layout(set = 0, binding = 0, std430) readonly buffer Source { uint source_texels[]; };
+layout(set = 0, binding = 1, std430) writeonly buffer Dest { uint dest_words[]; };
+
+uint Fetch(ivec2 position) {
+  position = clamp(position, ivec2(0), ivec2(constants.source_size) - 1);
+  return source_texels[uint(position.y) * constants.source_size.x + uint(position.x)];
+}
+vec4 Unpack(uint texel) {
+  return vec4(uvec4(texel, texel >> 8u, texel >> 16u, texel >> 24u) & 0xFFu);
+}
+// xenos::Float32To20e4 without rounding (the value came from a float24).
+uint ToFloat24(uint u) {
+  if (!(uintBitsToFloat(u) > 0.0)) {
+    return 0u;
+  }
+  if (u >= 0x3FFFFFF8u) {
+    return 0xFFFFFFu;
+  }
+  if (u < 0x38800000u) {
+    uint shift = min(113u - (u >> 23u), 24u);
+    u = (0x800000u | (u & 0x7FFFFFu)) >> shift;
+  } else {
+    u += 0xC8000000u;
+  }
+  return (u >> 3u) & 0xFFFFFFu;
+}
+uint EndianSwap(uint value, uint endian) {
+  if (endian == 1u || endian == 2u) {
+    value = ((value & 0x00FF00FFu) << 8u) | ((value & 0xFF00FF00u) >> 8u);
+  }
+  if (endian == 2u || endian == 3u) {
+    value = (value << 16u) | (value >> 16u);
+  }
+  return value;
+}
+// texture_util::GetTiledOffset2D for 4 bytes per block.
+int TiledOffset2D(ivec2 p, uint pitch) {
+  int macro = ((p.x >> 5) + (p.y >> 5) * int(pitch >> 5u)) << 9;
+  int micro = ((p.x & 7) + ((p.y & 0xE) << 2)) << 2;
+  int offset = macro + ((micro & ~0xF) << 1) + (micro & 0xF) + ((p.y & 1) << 4);
+  return ((offset & ~0x1FF) << 3) + ((p.y & 16) << 7) + ((offset & 0x1C0) << 2) +
+         (((((p.y & 8) >> 2) + (p.x >> 3)) & 3) << 6) + (offset & 0x3F);
+}
+void main() {
+  uvec2 dest_texel = gl_GlobalInvocationID.xy;
+  if (any(greaterThanEqual(dest_texel, constants.dest_size))) {
+    return;
+  }
+  uvec2 guest_texel = dest_texel / constants.dest_scale;
+  uvec2 sub_texel = dest_texel - guest_texel * constants.dest_scale;
+  uint texel;
+  if (constants.filter_mode == 0u) {
+    texel = Fetch(ivec2(dest_texel));
+  } else {
+    vec2 source_position = (vec2(guest_texel) + 0.5) * constants.source_per_guest;
+    if (constants.filter_mode == 1u) {
+      source_position -= 0.5;
+      ivec2 corner = ivec2(floor(source_position));
+      vec2 weights = source_position - floor(source_position);
+      vec4 color = mix(mix(Unpack(Fetch(corner)), Unpack(Fetch(corner + ivec2(1, 0))), weights.x),
+                       mix(Unpack(Fetch(corner + ivec2(0, 1))),
+                           Unpack(Fetch(corner + ivec2(1, 1))), weights.x),
+                       weights.y);
+      uvec4 bytes = uvec4(clamp(color + 0.5, 0.0, 255.0));
+      texel = bytes.x | (bytes.y << 8u) | (bytes.z << 16u) | (bytes.w << 24u);
+    } else {
+      texel = Fetch(ivec2(floor(source_position)));
+    }
+  }
+  uint word = texel;
+  if (constants.format == 1u) {
+    word = ToFloat24(texel) << 8u;
+  } else if (constants.format == 2u) {
+    // The image got float(unorm24) * (1.0 / 16777215.0): the unorm24 giving that value again.
+    float depth = clamp(uintBitsToFloat(texel), 0.0, 1.0);
+    int unorm24 = int(depth * 16777215.0 + 0.5);
+    for (int i = -2; i <= 2; ++i) {
+      int candidate = clamp(unorm24 + i, 0, 0xFFFFFF);
+      if (float(candidate) * (1.0 / 16777215.0) == depth) {
+        unorm24 = candidate;
+        break;
+      }
+    }
+    word = uint(clamp(unorm24, 0, 0xFFFFFF)) << 8u;
+  }
+  word = EndianSwap(word, constants.endian);
+  uint dest_index = ((uint(TiledOffset2D(ivec2(guest_texel), constants.pitch)) >> 2u) *
+                     (constants.dest_scale.x * constants.dest_scale.y)) +
+                    sub_texel.y * constants.dest_scale.x + sub_texel.x;
+  if (dest_index < constants.dest_word_count) {
+    dest_words[dest_index] = word;
+  }
+}
+)";
+  std::vector<uint32_t> spirv;
+  std::string error;
+  if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, kSource, spirv, error)) {
+    REXGPU_ERROR("Direct resolve: write-back pass: {}", error);
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkDescriptorSetLayout set_layout = command_processor_.GetSingleTransientDescriptorLayout(
