+  float difference = 0.0;
+  for (int y = -1; y <= 1; ++y) {
+    for (int x = -1; x <= 1; ++x) {
+      ivec2 tap = clamp(ivec2(pixel) + ivec2(x, y), ivec2(0), pixel_max);
+      vec3 tap_difference =
+          abs(texelFetch(xe_final, tap, 0).rgb - texelFetch(xe_hudless, tap, 0).rgb);
+      difference = max(difference, max(tap_difference.r, max(tap_difference.g, tap_difference.b)));
+    }
+  }
+  imageStore(xe_mask, ivec2(pixel), vec4(clamp((difference - xe_cutoff) * xe_scale, 0.0, 1.0)));
