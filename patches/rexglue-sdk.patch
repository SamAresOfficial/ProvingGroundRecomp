+        parameters.depth, VK_FORMAT_R32_SFLOAT, parameters.render_extent, kInputUsage,
+        FFX_API_RESOURCE_USAGE_READ_ONLY, FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
