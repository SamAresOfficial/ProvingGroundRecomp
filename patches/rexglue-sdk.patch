+    auto& own_rt = *static_cast<VulkanRenderTarget*>(owner_rt);
+    const uint32_t own_scale = owner.own_scale_sixteenths;
+    const uint32_t guest_x = (delta % pitch) * xenos::kEdramTileWidthSamples +
+                             (uint32_t(resolve_info.coordinate_info.edram_offset_x_div_8) << 3);
+    const uint32_t guest_y = (delta / pitch) * xenos::kEdramTileHeightSamples +
+                             (uint32_t(resolve_info.coordinate_info.edram_offset_y_div_8) << 3);
+    const uint32_t rt_width = owner.GetWidth() * own_scale / 16;
+    const uint32_t rt_height =
+        GetRenderTargetHeight(owner.pitch_tiles_at_32bpp, owner.msaa_samples) * own_scale / 16;
+    const uint32_t source_x = guest_x * own_scale / 16;
+    const uint32_t source_y = guest_y * own_scale / 16;
+    if (source_x >= rt_width || source_y >= rt_height) {
+      return false;
+    }
+    command_processor_.PushImageMemoryBarrier(
+        own_rt.image(),
+        ui::vulkan::util::InitializeSubresourceRange(
+            is_depth ? (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)
+                     : VK_IMAGE_ASPECT_COLOR_BIT),
+        own_rt.current_stage_mask(), VK_PIPELINE_STAGE_TRANSFER_BIT,
+        own_rt.current_access_mask(), VK_ACCESS_TRANSFER_READ_BIT, own_rt.current_layout(),
+        VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    own_rt.SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+                    VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    if (is_depth || dest_info.copy_dest_swap) {
+      return texture_cache.ResolveThroughBufferToTexture(
+          resolve_info.copy_dest_base, own_rt.image(), int32_t(source_x), int32_t(source_y), 0,
+          0, is_depth, depth_float24_round(), resolve_info.copy_dest_extent_start,
+          resolve_info.copy_dest_extent_length, own_scale, rt_width, rt_height,
+          depth_source_kind);
+    }
+    return texture_cache.ResolveDirectlyToOwnScaleTexture(
+        resolve_info.copy_dest_base, own_rt.image(), int32_t(source_x), int32_t(source_y),
+        rt_width, rt_height, own_scale, resolve_info.copy_dest_extent_start,
+        resolve_info.copy_dest_extent_length);
+  }
+  if (owner.own_scale_sixteenths) {
+    // native_main_pass_scale_sixteenths: the copy is made from the unscaled twin, with the
+    // source rectangle blitted into it first.
+    RenderTarget* twin = GetUnscaledTwin(owner_rt);
+    if (!twin) {
+      return false;
+    }
+    const uint32_t rt_width = owner.GetWidth();
+    const uint32_t rt_height = GetRenderTargetHeight(owner.pitch_tiles_at_32bpp, owner.msaa_samples);
+    Transfer::Rectangle rectangle;
+    rectangle.x_pixels = std::min(
+        (delta % pitch) * xenos::kEdramTileWidthSamples +
+            (uint32_t(resolve_info.coordinate_info.edram_offset_x_div_8) << 3),
+        rt_width);
+    rectangle.y_pixels = std::min(
+        (delta / pitch) * xenos::kEdramTileHeightSamples +
+            (uint32_t(resolve_info.coordinate_info.edram_offset_y_div_8) << 3),
+        rt_height);
+    rectangle.width_pixels =
+        std::min(uint32_t(resolve_info.coordinate_info.width_div_8) << 3,
+                 rt_width - rectangle.x_pixels);
+    rectangle.height_pixels =
+        std::min(uint32_t(resolve_info.height_div_8) << 3, rt_height - rectangle.y_pixels);
+    BlitRenderTargetRectangles(owner_rt, twin, &rectangle, 1);
+    owner_rt = twin;
+  }
+  auto& rt = *static_cast<VulkanRenderTarget*>(owner_rt);
+  const int32_t source_x = int32_t(((delta % pitch) * xenos::kEdramTileWidthSamples +
+                                    (resolve_info.coordinate_info.edram_offset_x_div_8 << 3)) *
+                                   scale_x);
+  const int32_t source_y = int32_t(((delta / pitch) * xenos::kEdramTileHeightSamples +
+                                    (resolve_info.coordinate_info.edram_offset_y_div_8 << 3)) *
+                                   scale_y);
+  command_processor_.PushImageMemoryBarrier(
+      rt.image(),
+      ui::vulkan::util::InitializeSubresourceRange(
+          is_depth ? (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)
+                   : VK_IMAGE_ASPECT_COLOR_BIT),
+      rt.current_stage_mask(), VK_PIPELINE_STAGE_TRANSFER_BIT, rt.current_access_mask(),
+      VK_ACCESS_TRANSFER_READ_BIT, rt.current_layout(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  rt.SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+              VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  if (is_depth || dest_info.copy_dest_swap) {
+    // Through a buffer with a conversion (float24, or the red/blue swap); on failure (no
+    // scratch buffer or pass), the resolve is done the usual way.
+    return texture_cache.ResolveThroughBufferToTexture(
+        resolve_info.copy_dest_base, rt.image(), source_x, source_y, fill_x, fill_y, is_depth,
+        depth_float24_round(), resolve_info.copy_dest_extent_start,
+        resolve_info.copy_dest_extent_length, 0, 0, 0, depth_source_kind);
+  }
+  texture_cache.ResolveDirectlyToTexture(resolve_info.copy_dest_base, rt.image(), source_x,
+                                         source_y, fill_x, fill_y,
+                                         resolve_info.copy_dest_extent_start,
+                                         resolve_info.copy_dest_extent_length);
+  return true;
+}
