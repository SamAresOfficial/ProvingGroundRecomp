+bool VulkanRenderTargetCache::TryResolveDirectlyToTexture(
+    const draw_util::ResolveInfo& resolve_info, VulkanTextureCache& texture_cache) {
+
+  if (GetPath() != Path::kHostRenderTargets || !resolve_info.copy_dest_extent_length ||
+      resolve_info.IsClearingDepth() ||
+      resolve_info.rb_copy_control.color_clear_enable ||
+      (resolve_info.rb_copy_control.copy_command != xenos::CopyCommand::kRaw &&
+       resolve_info.rb_copy_control.copy_command != xenos::CopyCommand::kConvert)) {
+    return false;
+  }
+  // Color: an 8888 target into an 8888 texture. Depth (the shadow maps): a float24 target
+  // (host D32_SFLOAT_S8_UINT) into a k_24_8_FLOAT texture (host R32_SFLOAT); the resolve
+  // writes the 32-bit depth/stencil words.
+  const bool is_depth = resolve_info.IsCopyingDepth();
+  if (is_depth ? !REXCVAR_GET(gpu_resolve_direct_texture_depth)
+               : !REXCVAR_GET(gpu_resolve_direct_texture_color)) {
+    return false;
+  }
+  const draw_util::ResolveEdramInfo source_info =
+      is_depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  if (source_info.msaa_samples != xenos::MsaaSamples::k1X || source_info.format_is_64bpp) {
+    return false;
+  }
+  // With resolution scaling, the usual resolve fills the half-pixel offset gap on the left/top
+  // (scale / 2 host pixels) with the first covered column/row; the copy does the same, for the
+  // scales where that count is unambiguous (1, 2, 4).
+  const uint32_t scale_x = draw_resolution_scale_x();
+  const uint32_t scale_y = draw_resolution_scale_y();
+  if ((scale_x != 1 && scale_x != 2 && scale_x != 4) ||
+      (scale_y != 1 && scale_y != 2 && scale_y != 4)) {
+    return false;
+  }
+  const uint32_t fill_x = source_info.fill_half_pixel_offset ? scale_x >> 1 : 0;
+  const uint32_t fill_y = source_info.fill_half_pixel_offset ? scale_y >> 1 : 0;
+  const bool depth_unorm24 = is_depth && xenos::DepthRenderTargetFormat(source_info.format) ==
+                                              xenos::DepthRenderTargetFormat::kD24S8;
+  if (is_depth ? xenos::DepthRenderTargetFormat(source_info.format) !=
+                         xenos::DepthRenderTargetFormat::kD24FS8 &&
+                     !depth_unorm24
+               : xenos::ColorRenderTargetFormat(source_info.format) !=
+                     xenos::ColorRenderTargetFormat::k_8_8_8_8) {
+    return false;
+  }
+  // The texture must get the value the usual resolve writes: the copy converts the host
+  // float32 depth to float24 and back (without it, near-equal shadow compares of characters
+  // shadowing themselves flickered); unorm24 depth (the main scene's, sampled as k_24_8) is
+  // rounded to 24 bits.
+  uint32_t depth_source_kind = VulkanTextureCache::kDepthSourceFloat24;
+  if (is_depth) {
+    const VkFormat depth_host_format =
+        GetDepthVulkanFormat(xenos::DepthRenderTargetFormat(source_info.format));
+    if (depth_host_format == VK_FORMAT_D24_UNORM_S8_UINT && depth_unorm24) {
+      depth_source_kind = VulkanTextureCache::kDepthSourceUnorm24;
+    } else if (depth_host_format != VK_FORMAT_D32_SFLOAT_S8_UINT) {
+      return false;
+    } else if (depth_unorm24) {
+      depth_source_kind = VulkanTextureCache::kDepthSourceUnorm24AsFloat32;
+    }
+  }
+  const reg::RB_COPY_DEST_INFO dest_info = resolve_info.copy_dest_info;
