+      if (++paint_context.swapchain_present_wait_timeouts >= kMaxPresentWaitTimeouts) {
+        REXLOG_WARN(
+            "VulkanPresenter: {} waits for a present timed out in a row, pacing without present "
+            "wait on this swapchain",
+            paint_context.swapchain_present_wait_timeouts);
+        paint_context.swapchain_present_wait_usable = false;
+        return false;
+      }
+      // The vblank times are unknown now: present this frame at once and learn them again.
+      vblank_clock.Reset();
+    } else if (wait_result != VK_SUCCESS && wait_result != VK_SUBOPTIMAL_KHR) {
+      REXLOG_WARN("VulkanPresenter: Waiting for a present failed ({}), pacing without it",
+                  int32_t(wait_result));
+      paint_context.swapchain_present_wait_usable = false;
+      return false;
+    } else {
+      paint_context.swapchain_present_wait_timeouts = 0;
+    }
+    vblank_clock.SetPeriod(sync.refresh_period);
