+bool VulkanPresenter::PaceSynchronizedPresent(VkPresentIdKHR& present_id_out) {
+  PaintContext& paint_context = paint_context_;
+  if (!paint_context.swapchain_present_synchronized || !paint_context.swapchain_is_fifo) {
+    return false;
+  }
+#if defined(REX_HAS_FIDELITYFX_FRAMEGEN) && REX_HAS_FIDELITYFX_FRAMEGEN
+  if (paint_context.frame_generation_queue_present) {
+    return false;
+  }
+#endif
+  const present_sync::Decision sync = present_sync::CurrentDecision();
+  const double frame_period = sync.interval * sync.refresh_period;
+  if (!IsPaintingFromGuestOutputThread()) {
+    // On the UI thread (UI drawn, or a surface where the GPU thread must not present FIFO), the
+    // presents don't hold the guest, and the UI must not stall on present waits: the app's
+    // limiter runs at whole refreshes, and FIFO keeps the frames on the vblanks.
+    if (sync.paces_target) {
+      SetPaintPacing(present_sync::Pacing::kAppAtDisplayPeriod, frame_period);
+    }
+    return false;
+  }
+  if (!paint_context.swapchain_present_wait_usable) {
+    // FIFO shows each frame from the next vblank on, and blocks the thread presenting while all
+    // the swapchain images are queued: that holds one frame per vblank, but it can't hold a
+    // frame for several vblanks by itself. The app's limiter does that then, at whole vblanks of
+    // the measured refresh rate.
+    if (sync.paces_target) {
+      SetPaintPacing(sync.interval == 1 ? present_sync::Pacing::kPresenter
+                                        : present_sync::Pacing::kAppAtDisplayPeriod,
+                     frame_period);
+    }
+    return false;
+  }
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  if (paint_context.swapchain_last_present_id) {
