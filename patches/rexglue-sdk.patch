+  x0 = std::max(x0, float(pa_sc_screen_scissor_tl.tl_x));
+  y0 = std::max(y0, float(pa_sc_screen_scissor_tl.tl_y));
+  x1 = std::min(x1, float(pa_sc_screen_scissor_br.br_x));
+  y1 = std::min(y1, float(pa_sc_screen_scissor_br.br_y));
+  if (!(x0 < x1) || !(y0 < y1)) {
+    return false;
+  }
+  x0_out = uint32_t(x0);
+  y0_out = uint32_t(y0);
+  x1_out = uint32_t(x1);
+  y1_out = uint32_t(y1);
+  return true;
+}
