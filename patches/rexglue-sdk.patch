+  vec2 motion_vector = vec2(0.0);
+  if (previous.w > 0.0) {
+    motion_vector = (previous.xy / previous.w - position) * xe_size_inv;
+  }
+  imageStore(xe_motion_vectors, ivec2(pixel), vec4(motion_vector, 0.0, 0.0));
+  imageStore(xe_depth, ivec2(pixel), vec4(depth));
