+)";
+
+// Where the final image differs from the image the game had before it drew the HUD: the HUD,
+// which neither moves with the camera nor is drawn with the jitter. Widened by a pixel to cover
+// the antialiased edges of the text.
+const char* const kTemporalUpscaleMaskComputeSource = R"(#version 450
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(push_constant) uniform XeTemporalUpscaleMaskConstants {
+  uvec2 xe_size;
+  float xe_cutoff;
+  float xe_scale;
