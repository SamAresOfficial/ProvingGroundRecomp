diff --git a/include/rex/ui/present_sync.h b/include/rex/ui/present_sync.h
new file mode 100644
index 0000000..18b425f
--- /dev/null
+++ b/include/rex/ui/present_sync.h
@@ -0,0 +1,147 @@
+#pragma once
+
+// Synchronization of host presentation with the display, shared between the presenters and the
+// app.
+//
+// The presenters present without vertical sync by default (tearing, so variable refresh rate
+// works). An app that holds the guest at a frame rate limit can ask for presentation synced to
+// the display instead, so a limit that equals or divides the refresh rate is shown on whole
+// vblanks rather than torn and beating against the scan-out. The presenter then also paces the
+// frames on the real vblanks where it can, and reports that, so the app's own timer can step
+// aside instead of waiting a second time.
+
+#include <cmath>
+#include <cstdint>
+#include <string_view>
+
+namespace rex::ui::present_sync {
+
+enum class Mode : uint32_t {
+  // Never synced: tearing, variable refresh rate (the presenters' original behavior, and the
+  // default when the app never calls SetMode).
+  kOff,
+  // Synced when the target frame rate equals or evenly divides the display refresh rate,
+  // unsynced otherwise (a limit of 0, or one that doesn't divide the refresh rate, works best
+  // with variable refresh rate).
+  kAuto,
+  // Always synced.
+  kOn,
+};
+
+// "off", "auto" or "on"; anything else is kAuto.
+inline Mode ParseMode(std::string_view name) {
+  if (name == "off") return Mode::kOff;
+  if (name == "on") return Mode::kOn;
+  return Mode::kAuto;
+}
+
+// Direct3D 12 accepts a sync interval of at most 4, and the same limit is kept on Vulkan so both
+// renderers behave the same (240 Hz at 30 FPS presents unsynced in kAuto).
+constexpr uint32_t kMaxInterval = 4;
+
+struct Decision {
+  // Present with vertical sync.
+  bool synchronized = false;
+  // Vblanks each frame is shown for when synchronized.
+  uint32_t interval = 1;
+  // Synchronized, and interval vblanks at the refresh rate are the target frame rate, so pacing
+  // on the vblanks holds the target exactly.
+  bool paces_target = false;
+  // The refresh period (seconds) the decision was made for, 0 if unknown.
+  double refresh_period = 0.0;
+};
+
+// Number of vblanks per frame when the target frame rate equals or evenly divides the refresh
+// rate, or 0. The rates are compared with a 1% tolerance, as displays run at fractional rates
+// such as 59.94 or 143.98 Hz while the limits are whole numbers.
+inline uint32_t DividingInterval(double refresh_hz, uint32_t target_fps,
+                                 uint32_t max_interval = kMaxInterval) {
+  if (!(refresh_hz > 0.0) || !target_fps) return 0;
+  const double ratio = refresh_hz / double(target_fps);
+  const double rounded = std::round(ratio);
+  if (rounded < 1.0 || rounded > double(max_interval)) return 0;
+  if (std::abs(ratio - rounded) > 0.01 * rounded) return 0;
+  return uint32_t(rounded);
+}
+
+inline Decision Decide(Mode mode, double refresh_hz, uint32_t target_fps,
+                       uint32_t max_interval = kMaxInterval) {
+  Decision decision;
+  if (refresh_hz > 0.0) decision.refresh_period = 1.0 / refresh_hz;
+  if (mode == Mode::kOff) return decision;
+  const uint32_t interval = DividingInterval(refresh_hz, target_fps, max_interval);
+  if (interval) {
+    decision.synchronized = true;
+    decision.interval = interval;
+    decision.paces_target = true;
+  } else if (mode == Mode::kOn) {
+    // Plain vsync: each frame is shown on the next vblank, and the app's limiter keeps the rate.
+    decision.synchronized = true;
+  }
+  return decision;
+}
+
+// Settings from the app, read by the presenters (any thread).
+void SetMode(Mode mode);
+Mode GetMode();
+// The app's frame rate limit, 0 for unlimited.
+void SetTargetFrameRate(uint32_t fps);
+uint32_t GetTargetFrameRate();
+
+// Refresh rate of the display the presentation window is on, in Hz, or 0 if unknown. Written by
+// the presenter on the UI thread when the window's monitor or display mode changes.
+void SetDisplayRefreshRate(double hz);
+double GetDisplayRefreshRate();
+
+// The current decision for the mode, the target and the display refresh rate.
+inline Decision CurrentDecision() {
+  return Decide(GetMode(), GetDisplayRefreshRate(), GetTargetFrameRate());
+}
+
+enum class Pacing : uint32_t {
+  // The presenter doesn't pace the frames: the app's limiter does.
+  kNone,
+  // The presenter holds each frame for whole vblanks at the target rate (it blocks the thread
+  // presenting until the frame's vblank), so the app's limiter must not wait as well.
+  kPresenter,
+  // Presentation is synced, but the presenter can't skip vblanks by itself: the app's limiter
+  // should run at the period reported with it (whole vblanks at the measured refresh rate, not
+  // 1 / the target), so the frames don't drift against the scan-out.
+  kAppAtDisplayPeriod,
+};
+
+// Called by the presenter after each present. A report older than about 100 ms (no presents: the
+// window is minimized, the device was lost) counts as kNone.
+void ReportPacing(Pacing pacing, double frame_period_seconds);
+Pacing GetPacing(double* frame_period_seconds_out = nullptr);
+
+// Sleeps until the steady clock reaches the deadline (in seconds of
+// std::chrono::steady_clock), with a high-resolution timer and a short spin at the end.
+void SleepUntil(double deadline_seconds);
+// The steady clock in seconds.
+double Now();
+
+// Vblank times of a display, for presenters that learn when their presents reach the screen
+// (VK_KHR_present_wait): the last observed vblank, and the refresh period to extrapolate from it.
+class VblankClock {
+ public:
+  void Reset() { anchor_ = 0.0; }
+  void SetPeriod(double period) { period_ = period; }
+  double period() const { return period_; }
+  bool has_anchor() const { return anchor_ > 0.0; }
+  // A vblank happened at `t` (a wait for a present to reach the screen blocked until then).
+  void Anchor(double t) { anchor_ = t; }
+  // The first vblank at or after `t`, extrapolated from the anchor; `t` without an anchor.
+  double NextVblankAt(double t) const {
+    if (!has_anchor() || !(period_ > 0.0) || t <= anchor_) {
+      return has_anchor() && t <= anchor_ ? anchor_ : t;
+    }
+    return anchor_ + std::ceil((t - anchor_) / period_) * period_;
+  }
+
+ private:
+  double anchor_ = 0.0;
+  double period_ = 0.0;
+};
+
+}  // namespace rex::ui::present_sync
