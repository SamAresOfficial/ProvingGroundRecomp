+bool VulkanCommandProcessor::NativeReplayKeyForDraw(const VulkanShader* vertex_shader,
+                                                    const void* vertex_translation,
+                                                    const void* pixel_translation,
+                                                    const IndexBufferInfo* index_buffer_info,
+                                                    uint32_t index_count,
+                                                    NativeReplayKey& key_out) {
+  const Shader::ConstantRegisterMap& constant_map = vertex_shader->constant_register_map();
+  uint32_t vfetch_index = UINT32_MAX;
+  for (uint32_t i = 0; i < rex::countof(constant_map.vertex_fetch_bitmap); ++i) {
+    uint32_t bit;
+    if (rex::bit_scan_forward(constant_map.vertex_fetch_bitmap[i], &bit)) {
+      vfetch_index = i * 32 + bit;
+      break;
+    }
+  }
+  if (vfetch_index == UINT32_MAX) {
+    return false;
+  }
+  const xenos::xe_gpu_vertex_fetch_t vfetch = register_file_->GetVertexFetch(vfetch_index);
+  const uint32_t vb_start = vfetch.address << 2;
+  // Only vertex buffers in the registry (static mesh data). Looked up here too: the vertex
+  // buffer loop skips buffers still in sync, and the found ranges are forgotten whenever any
+  // range is replaced.
+  if (!native_ranges::Count() || !FindNativeRange(vb_start, vfetch.size << 2)) {
+    return false;
+  }
+  key_out.vb = vb_start;
+  key_out.ib = index_buffer_info ? index_buffer_info->guest_base : 0;
+  key_out.count = index_count;
+  key_out.vertex_translation = vertex_translation;
+  key_out.pixel_translation = pixel_translation;
+  return true;
+}
