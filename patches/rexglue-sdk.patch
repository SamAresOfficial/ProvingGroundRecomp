+void TemporalJitterOffset(uint32_t index, uint32_t phase_count, float offset_out[2]) {
+  offset_out[0] = TemporalJitterHalton(index % phase_count + 1, 2) - 0.5f;
+  offset_out[1] = TemporalJitterHalton(index % phase_count + 1, 3) - 0.5f;
