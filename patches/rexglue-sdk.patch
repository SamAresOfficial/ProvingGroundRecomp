+  present_id_out.pNext = nullptr;
+  present_id_out.swapchainCount = 1;
+  present_id_out.pPresentIds = &paint_context.swapchain_last_present_id;
+  if (sync.paces_target) {
+    SetPaintPacing(present_sync::Pacing::kPresenter, frame_period);
+  }
+  return true;
+}
