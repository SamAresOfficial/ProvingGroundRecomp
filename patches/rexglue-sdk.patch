+bool SharedMemory::AnyDeferredGpuWritePages(uint32_t page_first, uint32_t page_last) const {
+  page_first = std::max(page_first, deferred_gpu_write_page_first_);
+  page_last = std::min(page_last, deferred_gpu_write_page_last_);
+  if (page_first > page_last) {
+    return false;
+  }
+  for (uint32_t block = page_first >> 6; block <= page_last >> 6; ++block) {
+    uint64_t bits = deferred_gpu_write_pages_[block];
+    if (block == page_first >> 6) {
+      bits &= ~((uint64_t(1) << (page_first & 63)) - 1);
+    }
+    if (block == page_last >> 6 && (page_last & 63) != 63) {
+      bits &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    if (bits) {
+      return true;
+    }
+  }
+  return false;
