+bool SharedMemory::IsPageWatched(uint32_t page) const {
+  uint32_t bucket = page << page_size_log2_ >> kWatchBucketSizeLog2;
+  for (const WatchNode* node = watch_buckets_[bucket]; node != nullptr;
