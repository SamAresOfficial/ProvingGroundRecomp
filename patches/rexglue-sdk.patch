+
+void SharedMemory::SetDeferredGpuWriteRanges(const std::pair<uint32_t, uint32_t>* ranges,
+                                             size_t count) {
+  // Few ranges (resolve destinations), and changes are rare next to requests, so the bits are
+  // simply rebuilt.
+  if (deferred_gpu_write_page_first_ <= deferred_gpu_write_page_last_) {
+    std::fill(deferred_gpu_write_pages_.begin() + (deferred_gpu_write_page_first_ >> 6),
+              deferred_gpu_write_pages_.begin() + (deferred_gpu_write_page_last_ >> 6) + 1,
+              uint64_t(0));
+  }
+  deferred_gpu_write_page_first_ = UINT32_MAX;
+  deferred_gpu_write_page_last_ = 0;
+  for (size_t i = 0; i < count; ++i) {
+    uint32_t start = ranges[i].first;
+    uint32_t length = ranges[i].second;
+    if (!length || start >= kBufferSize) {
+      continue;
+    }
+    length = std::min(length, kBufferSize - start);
+    if (deferred_gpu_write_pages_.empty()) {
+      deferred_gpu_write_pages_.resize(num_system_page_flags_);
+    }
+    uint32_t page_first = start >> page_size_log2_;
+    uint32_t page_last = (start + length - 1) >> page_size_log2_;
+    for (uint32_t block = page_first >> 6; block <= page_last >> 6; ++block) {
+      uint64_t bits = ~uint64_t(0);
+      if (block == page_first >> 6) {
+        bits &= ~((uint64_t(1) << (page_first & 63)) - 1);
+      }
+      if (block == page_last >> 6 && (page_last & 63) != 63) {
+        bits &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+      }
+      deferred_gpu_write_pages_[block] |= bits;
+    }
+    deferred_gpu_write_page_first_ = std::min(deferred_gpu_write_page_first_, page_first);
+    deferred_gpu_write_page_last_ = std::max(deferred_gpu_write_page_last_, page_last);
