+    }
+    uint64_t page_bit = uint64_t(1) << (page & 63);
+    if ((system_page_flags_valid_[page >> 6] & page_bit) &&
+        std::memcmp(memory().TranslatePhysical(page << page_size_log2_), hot_page.shadow.get(),
