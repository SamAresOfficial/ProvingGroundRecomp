+    // would otherwise queue up to the image count, each a refresh of latency), and tells when
+    // its vblank was.
+    const double timeout = std::max(0.1, 3.0 * frame_period);
+    const double wait_start = present_sync::Now();
+    const VkResult wait_result = dfn.vkWaitForPresentKHR(
+        vulkan_device_->device(), paint_context.swapchain,
+        paint_context.swapchain_last_present_id, uint64_t(timeout * 1e9));
+    const double wait_end = present_sync::Now();
+    present_sync::VblankClock& vblank_clock = paint_context.swapchain_vblank_clock;
+    // A run of timeouts means the window system doesn't report presents (some compositors do
+    // not); a single one can be a hidden window or a stall. Pace like FIFO without present wait
