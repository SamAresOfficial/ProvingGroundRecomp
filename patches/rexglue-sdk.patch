+// Puts the HUD of the final image (scaled bilinearly, as it has no jitter to resolve) over the
+// upscaled 3D scene where the mask says so.
+const char* const kTemporalUpscaleCompositeComputeSource = R"(#version 450
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(push_constant) uniform XeTemporalUpscaleCompositeConstants {
