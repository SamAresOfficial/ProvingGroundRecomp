+uint32_t TemporalJitterPhaseCount(uint32_t render_width, uint32_t output_width) {
+  if (!render_width) {
+    return 8;
+  }
+  const float scale = float(output_width) / float(render_width);
+  return std::max(uint32_t(8.0f * scale * scale), uint32_t(1));
+}
