+void VulkanCommandProcessor::ShutdownTemporalUpscale() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  DestroyTemporalUpscaleImages();
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device,
+                                         temporal_upscale_composite_pipeline_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device,
+                                         temporal_upscale_mask_pipeline_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device,
+                                         temporal_upscale_inputs_pipeline_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device,
+                                         temporal_upscale_pipeline_layout_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyDescriptorPool, device,
+                                         temporal_upscale_descriptor_pool_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyDescriptorSetLayout, device,
+                                         temporal_upscale_descriptor_set_layout_);
+  for (auto& frame_descriptors : temporal_upscale_descriptors_) {
+    frame_descriptors.fill(VK_NULL_HANDLE);
+  }
+  temporal_jitter_enabled_ = false;
+}
+
+void VulkanCommandProcessor::DestroyTemporalUpscaleImages() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (TemporalUpscaleImage& image : temporal_upscale_images_) {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, image.view);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImage, device, image.image);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, image.memory);
+    image = TemporalUpscaleImage();
+  }
+  temporal_upscale_images_extent_ = {};
+  temporal_upscale_inputs_cleared_ = false;
+}
+
+bool VulkanCommandProcessor::EnsureTemporalUpscaleImages(VkExtent2D extent) {
+  if (temporal_upscale_images_[0].image != VK_NULL_HANDLE &&
+      temporal_upscale_images_extent_.width == extent.width &&
+      temporal_upscale_images_extent_.height == extent.height) {
+    return true;
+  }
+  if (temporal_upscale_images_[0].image != VK_NULL_HANDLE) {
+    // Rare (the render resolution has changed): the earlier submissions that use the images are
+    // awaited rather than tracked.
+    CheckSubmissionFenceAndDeviceLoss(GetCurrentSubmission() - 1);
+    if (submission_completed_ + 1 < GetCurrentSubmission()) {
+      return false;
+    }
+  }
+  DestroyTemporalUpscaleImages();
+
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkImageCreateInfo image_create_info = {};
+  image_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+  image_create_info.imageType = VK_IMAGE_TYPE_2D;
+  image_create_info.extent = {extent.width, extent.height, 1};
+  image_create_info.mipLevels = 1;
+  image_create_info.arrayLayers = 1;
+  image_create_info.samples = VK_SAMPLE_COUNT_1_BIT;
+  image_create_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+  image_create_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  image_create_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  VkImageViewCreateInfo view_create_info = {};
+  view_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+  view_create_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+  view_create_info.subresourceRange = ui::vulkan::util::InitializeSubresourceRange();
+  for (uint32_t i = 0; i < kTemporalUpscaleImageCount; ++i) {
+    TemporalUpscaleImage& image = temporal_upscale_images_[i];
+    image_create_info.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT;
+    switch (i) {
+      case kTemporalUpscaleImageColor:
+        image_create_info.format = ui::vulkan::VulkanPresenter::kGuestOutputFormat;
+        // For the presenter's copy when the upscaler fails.
+        image_create_info.usage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+        break;
+      case kTemporalUpscaleImageDepth:
+        image_create_info.format = VK_FORMAT_R32_SFLOAT;
+        // Cleared for frames without a 3D scene.
+        image_create_info.usage |= VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+        break;
+      case kTemporalUpscaleImageMotionVectors:
+        image_create_info.format = VK_FORMAT_R16G16_SFLOAT;
+        image_create_info.usage |= VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+        break;
+      default:
+        image_create_info.format = VK_FORMAT_R8_UNORM;
+        break;
+    }
+    bool created = ui::vulkan::util::CreateDedicatedAllocationImage(
+        vulkan_device, image_create_info, ui::vulkan::util::MemoryPurpose::kDeviceLocal,
+        image.image, image.memory);
+    if (created) {
+      view_create_info.image = image.image;
+      view_create_info.format = image_create_info.format;
+      created =
+          dfn.vkCreateImageView(device, &view_create_info, nullptr, &image.view) == VK_SUCCESS;
+    }
+    if (!created) {
+      REXGPU_ERROR("Failed to create the temporal upscaling inputs of {}x{}", extent.width,
+                   extent.height);
+      DestroyTemporalUpscaleImages();
+      return false;
+    }
+  }
+  temporal_upscale_images_extent_ = extent;
+  return true;
+}
+
+void VulkanCommandProcessor::UseTemporalUpscaleImage(TemporalUpscaleImageIndex index,
+                                                     VkPipelineStageFlags stage_mask,
+                                                     VkAccessFlags access_mask,
+                                                     VkImageLayout layout, bool discard_contents) {
+  TemporalUpscaleImage& image = temporal_upscale_images_[index];
+  PushImageMemoryBarrier(image.image, ui::vulkan::util::InitializeSubresourceRange(),
+                         image.stage_mask ? image.stage_mask : VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                         stage_mask, image.access_mask, access_mask,
+                         discard_contents ? VK_IMAGE_LAYOUT_UNDEFINED : image.layout, layout);
+  image.stage_mask = stage_mask;
+  image.access_mask = access_mask;
+  image.layout = layout;
+}
+
+VulkanCommandProcessor::TemporalUpscaleFrame VulkanCommandProcessor::PrepareTemporalUpscale(
+    ui::vulkan::VulkanPresenter& presenter, uint32_t render_width, uint32_t render_height) {
+  using VulkanPresenter = ui::vulkan::VulkanPresenter;
+  TemporalUpscaleFrame frame;
+  frame.render_extent = {render_width, render_height};
+  if (render_width != temporal_upscale_last_render_extent_.width ||
+      render_height != temporal_upscale_last_render_extent_.height) {
+    // The resolution has changed (render_resolution or the FSR quality, live). The previous
+    // camera maps to pixels of the old size, so motion vectors from it would be wrong by the
+    // ratio of the sizes, and the upscaler's history is of the old input: both start over.
+    temporal_upscale_last_render_extent_ = frame.render_extent;
+    temporal_upscale_history_reset_ = true;
+    frame_generation_previous_camera_.valid = false;
+  }
+  temporal_upscale_camera_used_ = false;
+
+  // The time between the swaps is the frame time, whether or not this one is upscaled.
+  const uint64_t now_ns = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                       std::chrono::steady_clock::now().time_since_epoch())
+                                       .count());
+  const uint64_t last_swap_ns = temporal_upscale_last_swap_ns_;
+  temporal_upscale_last_swap_ns_ = now_ns;
+  if (last_swap_ns) {
+    const double frame_time_milliseconds = double(now_ns - last_swap_ns) * 1.0e-6;
+    if (frame_time_milliseconds > 500.0) {
+      // A loading screen or a long stall: what was on the screen before is not this scene.
+      temporal_upscale_history_reset_ = true;
+    }
+    frame.frame_time_milliseconds = float(std::clamp(frame_time_milliseconds, 1.0, 500.0));
+  }
+
+  VkExtent2D target_extent = {};
+  float sharpness = 0.0f;
+  if (!REXCVAR_GET(fsr_temporal_upscaling) ||
+      temporal_upscale_inputs_pipeline_ == VK_NULL_HANDLE ||
+      // The final image goes to the upscaler's color input through the gamma compute pass.
+      swap_apply_gamma_compute_256_entry_table_pipeline_ == VK_NULL_HANDLE ||
+      swap_apply_gamma_compute_pwl_pipeline_ == VK_NULL_HANDLE ||
+      (!GetVulkanDevice()->properties().imageViewFormatSwizzle &&
+       (swap_apply_gamma_compute_256_entry_table_rb_swap_pipeline_ == VK_NULL_HANDLE ||
+        swap_apply_gamma_compute_pwl_rb_swap_pipeline_ == VK_NULL_HANDLE)) ||
+      !presenter.GetTemporalUpscaleTarget(target_extent, sharpness)) {
+    temporal_upscale_output_extent_ = {};
+    temporal_upscale_pending_output_swaps_ = 0;
+    temporal_upscale_history_reset_ = true;
+    return frame;
+  }
+  frame.sharpness = sharpness;
+
+  // The jitter needs the 3D scene at the size of the final image. With the effects and the HUD
+  // at a whole-number scale and the 3D scene at another (resolution_scale and
+  // native_main_pass_scale_sixteenths), the final image is a resampled scene, which no jitter
+  // sequence fits: the presenter's FSR 1 takes it then.
+  if (frame_generation_camera_.valid) {
+    uint32_t depth_width, depth_height;
+    const bool depth_size_matches =
+        render_target_cache_->GetMainPassDepthHostSize(frame_generation_camera_.depth_key,
+                                                       depth_width, depth_height) &&
+        depth_width == render_width && depth_height == render_height;
+    if (depth_size_matches != temporal_upscale_depth_size_matches_) {
+      temporal_upscale_depth_size_matches_ = depth_size_matches;
+      if (depth_size_matches) {
+        REXGPU_INFO("Temporal upscaling: the 3D scene is at the size of the final image "
+                    "({}x{}) again",
+                    render_width, render_height);
+      } else {
+        REXGPU_WARN("Temporal upscaling is not used: the 3D scene is not drawn at the size of "
+                    "the final image ({}x{}); set resolution_scale to 1 so both follow "
+                    "native_main_pass_scale_sixteenths",
+                    render_width, render_height);
+      }
+    }
+  }
+  if (!temporal_upscale_depth_size_matches_) {
+    temporal_upscale_history_reset_ = true;
+    return frame;
+  }
+
+  // The size the presenter shows the image at follows the window. A window being resized asks
+  // for a new size on every frame, and each needs a new upscaler (slow to create, and created
+  // with the GPU idle), so a new size is taken once it has stayed for a while.
+  if (target_extent.width != temporal_upscale_output_extent_.width ||
+      target_extent.height != temporal_upscale_output_extent_.height) {
+    if (!temporal_upscale_output_extent_.width) {
+      temporal_upscale_output_extent_ = target_extent;
+    } else {
+      if (target_extent.width != temporal_upscale_pending_output_extent_.width ||
+          target_extent.height != temporal_upscale_pending_output_extent_.height) {
+        temporal_upscale_pending_output_extent_ = target_extent;
+        temporal_upscale_pending_output_swaps_ = 0;
+      }
+      if (++temporal_upscale_pending_output_swaps_ >= 20) {
+        temporal_upscale_output_extent_ = target_extent;
+        temporal_upscale_pending_output_swaps_ = 0;
+      }
+    }
+  } else {
+    temporal_upscale_pending_output_swaps_ = 0;
+  }
+  frame.output_extent = temporal_upscale_output_extent_;
+
+  const bool render_above_output = render_width > frame.output_extent.width ||
+                                   render_height > frame.output_extent.height;
+  if (render_above_output != temporal_upscale_render_above_output_) {
+    temporal_upscale_render_above_output_ = render_above_output;
+    if (render_above_output) {
+      REXGPU_WARN("Temporal upscaling is not used: the image is rendered at {}x{}, above the "
+                  "{}x{} it is shown at; the presenter scales it down",
+                  render_width, render_height, frame.output_extent.width,
+                  frame.output_extent.height);
+    } else {
+      REXGPU_INFO("Temporal upscaling: the render size {}x{} fits the output {}x{} again",
+                  render_width, render_height, frame.output_extent.width,
+                  frame.output_extent.height);
+    }
+  }
+  switch (presenter.GetTemporalUpscalerState(frame.render_extent, frame.output_extent)) {
+    case VulkanPresenter::TemporalUpscalerState::kReady:
+      break;
+    case VulkanPresenter::TemporalUpscalerState::kNeedsCreation:
+      // Everything recorded with the previous upscaler must be done, on the submission thread
+      // and on the GPU: the earlier submissions are awaited (the current one has none of it).
+      CheckSubmissionFenceAndDeviceLoss(GetCurrentSubmission() - 1);
+      if (submission_completed_ + 1 < GetCurrentSubmission() ||
+          !presenter.CreateTemporalUpscaler(frame.render_extent, frame.output_extent)) {
+        temporal_upscale_history_reset_ = true;
+        return frame;
+      }
+      temporal_upscale_history_reset_ = true;
+      break;
+    default:
+      temporal_upscale_history_reset_ = true;
+      return frame;
+  }
+  if (!EnsureTemporalUpscaleImages(frame.render_extent)) {
+    temporal_upscale_history_reset_ = true;
+    return frame;
+  }
+
+  if (temporal_jitter_enabled_) {
+    frame.jitter[0] = temporal_jitter_[0];
+    frame.jitter[1] = temporal_jitter_[1];
+  }
+  frame.active = true;
+  return frame;
+}
+
+void VulkanCommandProcessor::AdvanceTemporalJitter(const TemporalUpscaleFrame& frame) {
+  if (!frame.active || !temporal_upscale_camera_used_ || !REXCVAR_GET(fsr_temporal_jitter)) {
+    if (temporal_jitter_enabled_) {
+      temporal_jitter_enabled_ = false;
+      // The viewport of the next draw must be set again without the jitter.
+      dynamic_viewport_update_needed_ = true;
+    }
+    temporal_jitter_[0] = 0.0f;
+    temporal_jitter_[1] = 0.0f;
+    return;
+  }
+  TemporalJitterOffset(
+      ++temporal_jitter_index_,
+      TemporalJitterPhaseCount(frame.render_extent.width, frame.output_extent.width),
+      temporal_jitter_);
+  temporal_jitter_enabled_ = true;
+}
+
+bool VulkanCommandProcessor::IsTemporalJitterDraw(
+    const Shader& vertex_shader, reg::RB_DEPTHCONTROL normalized_depth_control) const {
+  // The 3D scene: draws with the depth test into the main scene's render targets, with
+  // positions in clip space going through the viewport. The post-processing passes and the HUD
+  // have no depth test (or give screen positions) and must stay where they are: they read the
+  // jittered scene through textures, or are not a part of it.
+  if (!temporal_jitter_enabled_ || !normalized_depth_control.z_enable ||
+      !render_target_cache_->IsLastUpdateDepthMainPass()) {
+    return false;
+  }
+  auto pa_cl_vte_cntl = register_file_->Get<reg::PA_CL_VTE_CNTL>();
+  if (pa_cl_vte_cntl.vtx_xy_fmt || !pa_cl_vte_cntl.vport_x_scale_ena ||
+      !pa_cl_vte_cntl.vport_y_scale_ena) {
+    return false;
+  }
+  if (REXCVAR_GET(fsr_temporal_jitter) >= 2) {
+    // Only the draws that take the camera from the constants the motion vectors come from.
+    int32_t world_view_projection_constant =
+        REXCVAR_GET(fsr3_camera_world_view_projection_constant);
+    if (world_view_projection_constant < 0) {
+      return false;
+    }
+    const Shader::ConstantRegisterMap& constant_map = vertex_shader.constant_register_map();
+    for (uint32_t i = uint32_t(world_view_projection_constant);
+         i < uint32_t(world_view_projection_constant) + 4; ++i) {
+      if (!(constant_map.float_bitmap[i >> 6] & (uint64_t(1) << (i & 63)))) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+bool VulkanCommandProcessor::IsTemporalUpscaleCameraCut(
+    const FrameGenerationCamera& camera, const FrameGenerationCamera& previous_camera,
+    VkExtent2D render_extent, double reprojection_out[4][4]) const {
+  double pixels_to_world[4][4];
+  if (!InvertMatrix4x4(camera.world_to_pixels, pixels_to_world)) {
+    return true;
+  }
+  MultiplyMatrices4x4(pixels_to_world, previous_camera.world_to_pixels, reprojection_out);
+  // Where points far away (so only the rotation matters) and a point near the camera (so a jump
+  // of its position does too) were in the previous frame: a camera that has turned or moved
+  // most of the screen away has cut to another view, which the previous output doesn't show.
+  const double limit = REXCVAR_GET(fsr_temporal_camera_cut) * double(render_extent.width);
+  const double width = double(render_extent.width), height = double(render_extent.height);
+  const double points[6][3] = {
+      {0.5 * width, 0.5 * height, 1.0},   {0.25 * width, 0.25 * height, 1.0},
+      {0.75 * width, 0.25 * height, 1.0}, {0.25 * width, 0.75 * height, 1.0},
+      {0.75 * width, 0.75 * height, 1.0}, {0.5 * width, 0.5 * height, 0.99},
+  };
+  for (const double* point : points) {
+    double previous[4];
+    for (uint32_t j = 0; j < 4; ++j) {
+      previous[j] = point[0] * reprojection_out[0][j] + point[1] * reprojection_out[1][j] +
+                    point[2] * reprojection_out[2][j] + reprojection_out[3][j];
+    }
+    if (!(previous[3] > 0.0)) {
+      return true;
+    }
+    const double delta_x = previous[0] / previous[3] - point[0];
+    const double delta_y = previous[1] / previous[3] - point[1];
+    if (!(delta_x * delta_x + delta_y * delta_y <= limit * limit)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void VulkanCommandProcessor::WriteTemporalUpscale(
+    ui::vulkan::VulkanPresenter::VulkanGuestOutputRefreshContext& context,
+    ui::vulkan::VulkanPresenter& presenter, const TemporalUpscaleFrame& frame,
+    const FrameGenerationCamera& camera, const FrameGenerationCamera& previous_camera,
+    VkImageView final_view, uint32_t hudless_address, xenos::TextureFormat frontbuffer_format,
+    uint32_t frame_index) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const std::array<VkDescriptorSet, kTemporalUpscaleDescriptorSetCount>& descriptor_sets =
+      temporal_upscale_descriptors_[frame_index];
+  const uint32_t width = frame.render_extent.width, height = frame.render_extent.height;
+  const VkImageSubresourceRange subresource_range = ui::vulkan::util::InitializeSubresourceRange();
+
+  auto write_descriptors = [&](VkDescriptorSet descriptor_set, VkImageView sampled_0,
+                               VkImageView sampled_1, VkImageView storage_2,
+                               VkImageView storage_3) {
+    const VkImageView views[4] = {sampled_0, sampled_1, storage_2, storage_3};
+    std::array<VkDescriptorImageInfo, 4> image_infos;
+    std::array<VkWriteDescriptorSet, 4> writes{};
+    uint32_t write_count = 0;
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (views[i] == VK_NULL_HANDLE) {
+        continue;
+      }
+      image_infos[i].sampler = i >= 2 ? VK_NULL_HANDLE : swap_sampler_linear_clamp_;
+      image_infos[i].imageView = views[i];
+      image_infos[i].imageLayout =
+          i >= 2 ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+      VkWriteDescriptorSet& write = writes[write_count++];
+      write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+      write.dstSet = descriptor_set;
+      write.dstBinding = i;
+      write.descriptorCount = 1;
+      write.descriptorType =
+          i >= 2 ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+      write.pImageInfo = &image_infos[i];
+    }
+    dfn.vkUpdateDescriptorSets(device, write_count, writes.data(), 0, nullptr);
+  };
+  auto dispatch = [&](VkPipeline pipeline, VkDescriptorSet descriptor_set, const void* constants,
+                      uint32_t constants_size, uint32_t dispatch_width,
+                      uint32_t dispatch_height) {
+    deferred_command_buffer_.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                                     temporal_upscale_pipeline_layout_, 0, 1,
+                                                     &descriptor_set, 0, nullptr);
+    deferred_command_buffer_.CmdVkPushConstants(temporal_upscale_pipeline_layout_,
+                                                VK_SHADER_STAGE_COMPUTE_BIT, 0, constants_size,
+                                                constants);
+    BindExternalComputePipeline(pipeline);
+    deferred_command_buffer_.CmdVkDispatch((dispatch_width + 7) / 8, (dispatch_height + 7) / 8, 1);
+  };
+
+  // The final image has just been written to the color input.
+  UseTemporalUpscaleImage(kTemporalUpscaleImageColor, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                          VK_ACCESS_SHADER_READ_BIT, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                          false);
+
+  // The depth of the 3D scene and the motion of the camera since the previous frame. A frame
+  // without a 3D scene (a menu, a loading screen, a video) or after a camera cut has nothing in
+  // common with the previous output, which the upscaler is then told not to use.
+  bool reset = temporal_upscale_history_reset_;
+  bool with_camera = camera.valid;
+  double reprojection[4][4] = {};
+  for (uint32_t i = 0; i < 4; ++i) {
+    reprojection[i][i] = 1.0;
+  }
+  VkImageView depth_view = VK_NULL_HANDLE;
+  if (with_camera) {
+    depth_view = render_target_cache_->UseDepthRenderTargetForComputeSampling(camera.depth_key);
+    rt_update_memo_valid_ = false;
+    with_camera = depth_view != VK_NULL_HANDLE;
+  }
+  if (with_camera) {
+    if (!previous_camera.valid ||
+        IsTemporalUpscaleCameraCut(camera, previous_camera, frame.render_extent, reprojection)) {
+      reset = true;
+      // No motion vectors without a camera to come from.
+      for (uint32_t i = 0; i < 4; ++i) {
+        for (uint32_t j = 0; j < 4; ++j) {
+          reprojection[i][j] = i == j ? 1.0 : 0.0;
+        }
+      }
+    }
+  } else {
+    reset = true;
+  }
+  temporal_upscale_camera_used_ = with_camera;
+  if (with_camera) {
+    VkDescriptorSet descriptor_set = descriptor_sets[kTemporalUpscaleDescriptorSetInputs];
+    write_descriptors(descriptor_set, depth_view, VK_NULL_HANDLE,
+                      temporal_upscale_images_[kTemporalUpscaleImageMotionVectors].view,
+                      temporal_upscale_images_[kTemporalUpscaleImageDepth].view);
+    UseTemporalUpscaleImage(kTemporalUpscaleImageMotionVectors,
+                            VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT,
+                            VK_IMAGE_LAYOUT_GENERAL, true);
+    UseTemporalUpscaleImage(kTemporalUpscaleImageDepth, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                            VK_ACCESS_SHADER_WRITE_BIT, VK_IMAGE_LAYOUT_GENERAL, true);
+    SubmitBarriers(true);
+    TemporalUpscaleInputsConstants constants;
+    for (uint32_t i = 0; i < 4; ++i) {
+      for (uint32_t j = 0; j < 4; ++j) {
+        constants.reprojection[i * 4 + j] = float(reprojection[i][j]);
+      }
+    }
+    constants.jitter[0] = frame.jitter[0];
+    constants.jitter[1] = frame.jitter[1];
+    constants.size_inv[0] = 1.0f / float(width);
+    constants.size_inv[1] = 1.0f / float(height);
+    constants.size[0] = width;
+    constants.size[1] = height;
+    dispatch(temporal_upscale_inputs_pipeline_, descriptor_set, &constants, sizeof(constants),
+             width, height);
+    temporal_upscale_inputs_cleared_ = false;
