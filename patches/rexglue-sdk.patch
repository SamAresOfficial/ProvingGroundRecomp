+bool VulkanPrimitiveProcessor::CreatePersistentIndexChunk() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  VkBufferCreateInfo buffer_create_info;
+  buffer_create_info.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+  buffer_create_info.pNext = nullptr;
+  buffer_create_info.flags = 0;
+  buffer_create_info.size = kPersistentIndexChunkSize;
+  buffer_create_info.usage = VK_BUFFER_USAGE_INDEX_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+  buffer_create_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  buffer_create_info.queueFamilyIndexCount = 0;
+  buffer_create_info.pQueueFamilyIndices = nullptr;
+  PersistentIndexChunk chunk;
+  if (dfn.vkCreateBuffer(device, &buffer_create_info, nullptr, &chunk.buffer) != VK_SUCCESS) {
+    REXGPU_ERROR("Vulkan primitive processor: Failed to create a static index buffer chunk");
+    return false;
+  }
+  VkMemoryRequirements memory_requirements;
+  dfn.vkGetBufferMemoryRequirements(device, chunk.buffer, &memory_requirements);
+
+  VkMemoryAllocateInfo memory_allocate_info;
+  memory_allocate_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+  memory_allocate_info.pNext = nullptr;
+  memory_allocate_info.allocationSize = memory_requirements.size;
+  VkMemoryDedicatedAllocateInfo memory_dedicated_allocate_info;
+  if (vulkan_device->extensions().ext_1_1_KHR_dedicated_allocation) {
+    memory_dedicated_allocate_info.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+    memory_dedicated_allocate_info.pNext = nullptr;
+    memory_dedicated_allocate_info.image = VK_NULL_HANDLE;
+    memory_dedicated_allocate_info.buffer = chunk.buffer;
+    memory_allocate_info.pNext = &memory_dedicated_allocate_info;
+  }
+
+  // Directly written memory first, preferring coherent memory that needs no flushes. If it
+  // can't be allocated (the heap is full), plain device-local memory with staging copies.
+  bool direct = false;
+  uint32_t direct_types =
+      REXCVAR_GET(vulkan_static_index_buffer_direct_write)
+          ? memory_requirements.memoryTypeBits & persistent_index_direct_memory_types_
+          : 0;
+  while (direct_types) {
+    uint32_t memory_type;
+    if (!rex::bit_scan_forward(direct_types & vulkan_device->memory_types().host_coherent,
+                               &memory_type)) {
+      rex::bit_scan_forward(direct_types, &memory_type);
+    }
+    direct_types &= ~(uint32_t(1) << memory_type);
+    memory_allocate_info.memoryTypeIndex = memory_type;
+    if (dfn.vkAllocateMemory(device, &memory_allocate_info, nullptr, &chunk.memory) ==
+        VK_SUCCESS) {
+      chunk.memory_type = memory_type;
+      direct = true;
+      break;
+    }
+  }
+  if (!direct) {
+    uint32_t memory_type = ui::vulkan::util::ChooseMemoryType(
+        vulkan_device->memory_types(), memory_requirements.memoryTypeBits,
+        ui::vulkan::util::MemoryPurpose::kDeviceLocal);
+    memory_allocate_info.memoryTypeIndex = memory_type;
+    if (memory_type == UINT32_MAX ||
+        dfn.vkAllocateMemory(device, &memory_allocate_info, nullptr, &chunk.memory) !=
+            VK_SUCCESS) {
+      REXGPU_ERROR(
+          "Vulkan primitive processor: Failed to allocate memory for a static index buffer "
+          "chunk");
+      ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device, chunk.buffer);
+      return false;
+    }
+    chunk.memory_type = memory_type;
+  }
+  chunk.memory_size = memory_requirements.size;
+  if (dfn.vkBindBufferMemory(device, chunk.buffer, chunk.memory, 0) != VK_SUCCESS) {
+    REXGPU_ERROR("Vulkan primitive processor: Failed to bind a static index buffer chunk");
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device, chunk.buffer);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, chunk.memory);
+    return false;
+  }
+  if (direct) {
+    void* mapping;
+    if (dfn.vkMapMemory(device, chunk.memory, 0, VK_WHOLE_SIZE, 0, &mapping) != VK_SUCCESS) {
+      REXGPU_ERROR("Vulkan primitive processor: Failed to map a static index buffer chunk");
+      ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device, chunk.buffer);
+      ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, chunk.memory);
+      return false;
+    }
+    chunk.mapping = static_cast<uint8_t*>(mapping);
+  }
+  chunk.ranges.Reset(kPersistentIndexChunkSize);
+  REXGPU_INFO("Vulkan primitive processor: Static index buffer chunk {} in {}",
+              persistent_index_chunks_.size(),
+              direct ? "video memory written directly" : "video memory, staged");
+  persistent_index_chunks_.push_back(std::move(chunk));
+  return true;
+}
+
+void* VulkanPrimitiveProcessor::RequestPersistentConvertedIndexBuffer(
+    xenos::IndexFormat format, uint32_t index_count, uint32_t coalignment_original_address,
+    size_t& persistent_handle_out) {
+  const VkDeviceSize index_size =
+      format == xenos::IndexFormat::kInt16 ? sizeof(uint16_t) : sizeof(uint32_t);
+  const VkDeviceSize data_size = index_size * index_count;
+  // Room for co-alignment with the guest indices when written directly.
+  const VkDeviceSize allocation_size =
+      (data_size + XE_GPU_PRIMITIVE_PROCESSOR_SIMD_SIZE + sizeof(uint32_t) +
+       kPersistentIndexAllocationAlignment - 1) &
+      ~(kPersistentIndexAllocationAlignment - 1);
+  if (allocation_size > kPersistentIndexChunkSize) {
+    return nullptr;
+  }
+
+  // First fit in the existing chunks, then a new chunk within the budget.
+  uint32_t chunk_index = 0;
+  uint64_t allocation_offset = PersistentIndexRangeAllocator::kInvalidOffset;
+  for (; chunk_index < persistent_index_chunks_.size(); ++chunk_index) {
+    allocation_offset = persistent_index_chunks_[chunk_index].ranges.Allocate(allocation_size);
+    if (allocation_offset != PersistentIndexRangeAllocator::kInvalidOffset) {
+      break;
+    }
+  }
+  if (allocation_offset == PersistentIndexRangeAllocator::kInvalidOffset) {
+    const uint64_t budget_bytes = uint64_t(REXCVAR_GET(vulkan_static_index_buffer_budget_mb))
+                                  << 20;
+    const size_t max_chunks =
+        size_t((budget_bytes + kPersistentIndexChunkSize - 1) / kPersistentIndexChunkSize);
+    if (persistent_index_chunks_.size() >= max_chunks || !CreatePersistentIndexChunk()) {
+      if (!persistent_index_budget_warned_ && max_chunks) {
+        persistent_index_budget_warned_ = true;
+        REXGPU_WARN(
+            "Vulkan primitive processor: Static index buffer space ({} MB) is full; meshes that "
+            "don't fit are converted every frame (vulkan_static_index_buffer_budget_mb)",
+            uint64_t(persistent_index_chunks_.size()) * (kPersistentIndexChunkSize >> 20));
+      }
+      return nullptr;
+    }
+    chunk_index = uint32_t(persistent_index_chunks_.size() - 1);
+    allocation_offset = persistent_index_chunks_[chunk_index].ranges.Allocate(allocation_size);
+    assert_true(allocation_offset != PersistentIndexRangeAllocator::kInvalidOffset);
+  }
+  PersistentIndexChunk& chunk = persistent_index_chunks_[chunk_index];
+  const uint64_t submission_current = command_processor_.GetCurrentSubmission();
+
+  uint8_t* mapping;
+  VkDeviceSize buffer_offset;
+  if (chunk.mapping) {
+    mapping = chunk.mapping + allocation_offset;
+    ptrdiff_t coalignment_offset = GetSimdCoalignmentOffset(mapping, coalignment_original_address);
+    mapping += coalignment_offset;
+    buffer_offset = VkDeviceSize(allocation_offset + coalignment_offset);
+    chunk.flush_begin = std::min(chunk.flush_begin, buffer_offset);
+    chunk.flush_end = std::max(chunk.flush_end, buffer_offset + data_size);
+  } else {
+    VkBuffer staging_buffer;
+    VkDeviceSize staging_offset;
+    mapping = persistent_index_staging_pool_->Request(
+        submission_current, size_t(data_size) + XE_GPU_PRIMITIVE_PROCESSOR_SIMD_SIZE,
+        std::max(size_t(index_size), size_t(XE_GPU_PRIMITIVE_PROCESSOR_SIMD_SIZE)),
+        staging_buffer, staging_offset);
+    if (!mapping) {
+      chunk.ranges.Free(allocation_offset, allocation_size);
+      return nullptr;
+    }
+    ptrdiff_t coalignment_offset = GetSimdCoalignmentOffset(mapping, coalignment_original_address);
+    mapping += coalignment_offset;
+    // The copy re-aligns the indices to the allocation, which suits any index size.
+    buffer_offset = VkDeviceSize(allocation_offset);
+    VkBufferCopy region;
+    region.srcOffset = staging_offset + VkDeviceSize(coalignment_offset);
+    region.dstOffset = buffer_offset;
+    region.size = data_size;
+    chunk.pending_copies.emplace_back(staging_buffer, region);
+    persistent_index_staging_last_submission_ = submission_current;
+    persistent_index_staging_idle_frames_ = 0;
+  }
+
+  size_t persistent_handle;
+  if (!persistent_index_slots_free_.empty()) {
+    persistent_handle = persistent_index_slots_free_.back();
+    persistent_index_slots_free_.pop_back();
+  } else {
+    persistent_handle = persistent_index_slots_.size();
+    persistent_index_slots_.emplace_back();
+  }
+  PersistentIndexSlot& slot = persistent_index_slots_[persistent_handle];
+  slot.chunk = chunk_index;
+  slot.allocation_offset = VkDeviceSize(allocation_offset);
+  slot.allocation_size = allocation_size;
+  persistent_index_used_bytes_ += allocation_size;
+  slot.buffer_offset = buffer_offset;
+  slot.last_use_submission = submission_current;
+  persistent_handle_out = persistent_handle;
+  return mapping;
+}
+
+size_t VulkanPrimitiveProcessor::UsePersistentConvertedIndexBuffer(size_t persistent_handle) {
+  if (persistent_handle >= persistent_index_slots_.size()) {
+    return SIZE_MAX;
+  }
+  PersistentIndexSlot& slot = persistent_index_slots_[persistent_handle];
+  slot.last_use_submission = command_processor_.GetCurrentSubmission();
+  size_t handle = frame_index_buffers_.size();
+  frame_index_buffers_.emplace_back(persistent_index_chunks_[slot.chunk].buffer,
+                                    slot.buffer_offset);
+  return handle;
+}
+
+bool VulkanPrimitiveProcessor::IsPersistentConvertedIndexBufferSpaceLow() const {
+  // 90% of the budget, rounded up to whole chunks as in RequestPersistentConvertedIndexBuffer.
+  const uint64_t budget_bytes = uint64_t(REXCVAR_GET(vulkan_static_index_buffer_budget_mb))
+                                << 20;
+  const uint64_t capacity = (budget_bytes + kPersistentIndexChunkSize - 1) /
+                            kPersistentIndexChunkSize * kPersistentIndexChunkSize;
+  return capacity && persistent_index_used_bytes_ * 10 >= capacity * 9;
+}
+
+void VulkanPrimitiveProcessor::ReleasePersistentConvertedIndexBuffer(size_t persistent_handle) {
+  if (persistent_handle >= persistent_index_slots_.size()) {
+    return;
+  }
+  // The command processor's native mesh draws bind the buffer they learned directly, without
+  // UsePersistentConvertedIndexBuffer, so last_use_submission may be older than their draws.
+  // They stop once the range loses its generation, which is before the entry is released, so
+  // the current submission is the last that may still read the slot.
+  PersistentIndexSlot& slot = persistent_index_slots_[persistent_handle];
+  slot.last_use_submission =
+      std::max(slot.last_use_submission, command_processor_.GetCurrentSubmission());
+  persistent_index_slots_released_.push_back(persistent_handle);
+}
+
+void VulkanPrimitiveProcessor::FreePersistentIndexSlot(size_t persistent_handle) {
+  const PersistentIndexSlot& slot = persistent_index_slots_[persistent_handle];
+  persistent_index_chunks_[slot.chunk].ranges.Free(slot.allocation_offset, slot.allocation_size);
+  persistent_index_used_bytes_ -= slot.allocation_size;
+  persistent_index_slots_free_.push_back(persistent_handle);
+  ++persistent_index_buffer_frees_;
+}
+
